// Pontual Gestão — schema das Fases 0 (Fundação), 1 (Cadastros), 2 (Comercial), 3 (Propostas), 4 (Obras) e 5 (Financeiro).
// Convenções (docs/ESPECIFICACAO.md, seção 4): nomes em português sem acento, dinheiro em
// centavos (Int), medidas em mm, exclusão lógica (deletadoEm) e colunas de auditoria.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================== Enums =====================

enum PapelUsuario {
  ADMIN
}

enum TipoDias {
  UTEIS
  CORRIDOS
}

enum TipoFeriado {
  FERIADO
  FERIAS_COLETIVA_FORNECEDORES
  OUTRO
}

enum TipoInteracao {
  LIGACAO
  WHATSAPP
  VISITA
  EMAIL
  NOTA
  SISTEMA
}

enum StatusTarefa {
  ABERTA
  CONCLUIDA
  CANCELADA
}

enum MomentoFoto {
  ANTES
  DURANTE
  DEPOIS
}

enum TipoCategoriaFinanceira {
  RECEITA
  DESPESA
}

/// Grupo do DRE gerencial (lista fixa: o DRE precisa de ordem e subtotais). Substitui o texto livre grupoDre.
enum GrupoDre {
  RECEITAS_OPERACIONAIS
  OUTRAS_RECEITAS
  IMPOSTOS
  CUSTOS_DIRETOS
  DESPESAS_FIXAS
  DESPESAS_OPERACIONAIS
  DESPESAS_COMERCIAIS
  DESPESAS_ADMINISTRATIVAS
  DESPESAS_FINANCEIRAS
}

enum CategoriaModeloTexto {
  PROPOSTA_NOTAS
  PROPOSTA_TERMOS
  WHATSAPP
  OUTRO
}

// ----- Fase 1 (Cadastros) -----

enum TipoPessoa {
  PF
  PJ
}

/// Origem do contato (R10). Também usada pelo Projeto na Fase 2.
enum OrigemContato {
  GOOGLE
  INDICACAO_CLIENTE
  ARQUITETO_PARCEIRO
  INSTAGRAM
  WHATSAPP
  SITE
  PLACA_NA_OBRA
  CLIENTE_ANTIGO
  OUTRO
}

enum TipoEndereco {
  COBRANCA
  OBRA
}

enum FuncaoFuncionario {
  VENDAS
  PROJETO
  FABRICA
  INSTALACAO
  ADMINISTRATIVO
  GESTAO
}

enum UnidadeProduto {
  UN
  M
  M2
  KG
  BARRA
  L
  PAR
  CJ
}

/// De onde veio a mudança de custo (R13).
enum OrigemPreco {
  MANUAL
  REAJUSTE_LOTE
  IMPORTACAO
  /// Último custo da compra recebida (Fase 6).
  COMPRA
  /// Recalculado a partir do preço do kg do alumínio (Fase 6).
  PRECO_KG
}

enum TipoImportacao {
  CLIENTES
  FORNECEDORES
  PRODUTOS
}

enum StatusLoteImportacao {
  APLICADO
  REVERTIDO
}

enum AcaoLoteItem {
  CRIADO
  ATUALIZADO
}

// ===================== Sistema =====================

model Usuario {
  id                 String           @id @default(cuid())
  nome               String
  /// Sempre gravado em minúsculas (login não diferencia maiúsculas).
  login              String           @unique
  /// Opcional; único quando preenchido. Sempre em minúsculas.
  email              String?          @unique
  senhaHash          String
  ativo              Boolean          @default(true)
  papel              PapelUsuario     @default(ADMIN)
  precisaTrocarSenha Boolean          @default(true)
  /// Incrementada ao trocar/redefinir senha ou desativar: invalida sessões antigas.
  versaoSessao       Int              @default(1)
  ultimoLoginEm      DateTime?
  funcionario        Funcionario?
  projetos           Projeto[]
  eventosAgenda      EventoAgenda[]
  feedsAgenda        FeedAgenda[]
  sessoesRevogadas   SessaoRevogada[]
  etapasProjeto      EtapaProjeto[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([ativo])
}

/// "Sair" revoga só o aparelho que saiu: o `sid` (id da sessão, gravado no JWT ao entrar) vai para
/// esta tabela e a conferência de banco de cada requisição o rejeita. Sem isso, uma resposta do proxy
/// que chega depois do logout devolve o cookie renovado e a sessão ressuscita (docs/DECISOES.md, 92).
/// Linhas com `expiraEm` passado já não servem (o token expirou) e podem ser varridas.
model SessaoRevogada {
  sid       String   @id
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  @@index([expiraEm])
  @@index([usuarioId])
}

model TentativaLogin {
  id            String   @id @default(cuid())
  /// Login ou e-mail digitado, em minúsculas.
  identificador String
  ip            String
  sucesso       Boolean
  criadoEm      DateTime @default(now())

  @@index([identificador, criadoEm])
  @@index([ip, criadoEm])
}

model ConfiguracaoEmpresa {
  /// Singleton: sempre "singleton".
  id                  String  @id @default("singleton")
  razaoSocial         String?
  nomeFantasia        String?
  cnpj                String?
  endereco            String?
  cidade              String?
  uf                  String?
  cep                 String?
  telefone            String?
  whatsapp            String?
  emailContato        String?
  emailPropostas      String?
  siteUrl             String?
  instagramUrl        String?
  googlePerfilUrl     String?
  /// Link direto para escrever avaliação (diferente do link de compartilhamento do perfil).
  linkAvaliacaoGoogle String?
  logoCaminho         String?
  corPrimaria         String?

  // Horário comercial (HH:mm); vazio = sem expediente naquele dia.
  horarioSemanaInicio String? @default("08:00")
  horarioSemanaFim    String? @default("18:00")
  horarioSabadoInicio String? @default("08:00")
  horarioSabadoFim    String? @default("12:00")
  visitaDuracaoMin    Int     @default(60)

  // Parâmetros de negócio. Alíquota e margens ficam VAZIAS até o gestor definir.
  aliquotaImpostoPercentual     Decimal? @db.Decimal(5, 2)
  margemPadraoPercentual        Decimal? @db.Decimal(5, 2)
  margemMinimaAlertaPercentual  Decimal? @db.Decimal(5, 2)
  metaFaturamentoMensalCentavos Int      @default(30000000)
  capacidadeProducaoM2Mes       Int      @default(300)
  garantiaRegulagemDias         Int      @default(90)
  retalhoMinimoMm               Int?
  custoMaoDeObraPorM2Centavos   Int?
  tipoDias                      TipoDias @default(UTEIS)
  diasFollowUpProposta          Int      @default(3)
  /// R11: dias sem resposta para a proposta entrar na lista "Sem retorno" (padrão de configuração, editável).
  diasSemRetornoProposta        Int      @default(7)
  /// R11: dias após a conclusão da obra para a tarefa "Pedir avaliação no Google".
  diasPedidoAvaliacao           Int      @default(2)
  /// R10: faixas OPCIONAIS para sugerir o porte. Vazias até o gestor definir (nunca inventadas).
  porteMedioMinimoCentavos      Int?
  porteGrandeMinimoCentavos     Int?
  diasAlertaPrazoAmarelo        Int      @default(3)
  limiteSimplesCentavos         Int      @default(480000000)

  // Financeiro (Fase 5): parâmetros editáveis em Configurações → Empresa.
  /// Categoria sugerida ao registrar o recebimento de parcelas (vazia = o gestor escolhe a cada vez).
  categoriaReceitaPadraoId String?
  /// Quantos meses à frente as recorrências geram contas a pagar.
  mesesRecorrenciaAFrente  Int     @default(3)
  /// Janela de "vence em breve" nas listas e no painel (dias).
  diasAlertaVencimento     Int     @default(7)
  /// Dias antes do vencimento para a tarefa "Cobrar parcela" (0 = no próprio dia).
  diasLembreteCobranca     Int     @default(0)

  // Propostas
  proximoNumeroProposta   Int?
  reiniciaNumeracaoPorAno Boolean @default(false)
  /// Ano em que o contador de propostas foi usado pela última vez (reinício por ano opcional).
  anoNumeracaoProposta    Int?
  /// Acréscimo sobre o preço quando a proposta é COM nota fiscal (pontos-base: 5% = 500). Regra do dono.
  acrescimoNotaPb         Int     @default(500)
  consultorNome           String?
  consultorCargo          String?
  /// Markup padrão SOBRE O CUSTO (pontos-base: 80% = 8000). Informado pelo dono; editável em Configurações.
  markupPadraoPb          Int     @default(8000)
  /// Markup da categoria vidro temperado / guarda-corpo (100% = 10000). Informado pelo dono; editável.
  markupVidroTemperadoPb  Int     @default(10000)
  dadosPagamento          String?
  pdfExibirValorPorItem   Boolean @default(true)
  pdfDescricoesMaiusculas Boolean @default(true)

  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
}

model Feriado {
  id      String      @id @default(cuid())
  data    DateTime    @db.Date
  nome    String
  tipo    TipoFeriado @default(FERIADO)
  /// Fim do período, para férias coletivas (vazio = só um dia).
  dataFim DateTime?   @db.Date
  ativo   Boolean     @default(true)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@unique([data, nome])
  @@index([data])
}

model LogAuditoria {
  id          String   @id @default(cuid())
  criadoEm    DateTime @default(now())
  usuarioId   String?
  /// Nome do usuário no momento da ação (preserva o histórico se o usuário for removido).
  usuarioNome String?
  entidade    String
  entidadeId  String
  /// CRIAR, ATUALIZAR, EXCLUIR, RESTAURAR, LOGIN, etc.
  acao        String
  antes       Json?
  depois      Json?
  ip          String?

  @@index([entidade, entidadeId])
  @@index([usuarioId, criadoEm])
  @@index([criadoEm])
}

model Anexo {
  id              String       @id @default(cuid())
  entidadeTipo    String
  entidadeId      String
  categoria       String?
  nome            String
  /// Caminho do objeto no bucket privado do Storage.
  caminho         String       @unique
  mime            String
  tamanhoBytes    Int
  descricao       String?
  momento         MomentoFoto?
  usarNoPortfolio Boolean      @default(true)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([entidadeTipo, entidadeId])
}

model Interacao {
  id        String        @id @default(cuid())
  tipo      TipoInteracao
  texto     String
  clienteId String?
  cliente   Cliente?      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  projetoId String?
  projeto   Projeto?      @relation(fields: [projetoId], references: [id], onDelete: Restrict)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([clienteId, criadoEm])
  @@index([projetoId, criadoEm])
}

model Tarefa {
  id            String       @id @default(cuid())
  titulo        String
  descricao     String?
  tipo          String?
  responsavelId String?
  vencimento    DateTime?    @db.Date
  status        StatusTarefa @default(ABERTA)
  concluidaEm   DateTime?
  clienteId     String?
  cliente       Cliente?     @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  projetoId     String?
  projeto       Projeto?     @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  /// Evita duplicar tarefas automáticas (ex.: "follow-up:proposta:123").
  chaveUnica    String?      @unique

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([responsavelId, status, vencimento])
  @@index([status, vencimento])
  @@index([projetoId, status])
}

model Notificacao {
  id         String   @id @default(cuid())
  /// Vazio = para todos os usuários.
  usuarioId  String?
  tipo       String
  titulo     String
  texto      String?
  link       String?
  lida       Boolean  @default(false)
  /// Idempotência das notificações geradas pelo cron.
  chaveUnica String?  @unique
  criadoEm   DateTime @default(now())

  @@index([usuarioId, lida, criadoEm])
}

model ModeloTexto {
  id        String               @id @default(cuid())
  chave     String               @unique
  titulo    String
  categoria CategoriaModeloTexto @default(OUTRO)
  conteudo  String
  ativo     Boolean              @default(true)
  ordem     Int                  @default(0)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

// ===================== Catálogos editáveis =====================

model LinhaAluminio {
  id              String            @id @default(cuid())
  nome            String            @unique
  ativo           Boolean           @default(true)
  ordem           Int               @default(0)
  produtos        Produto[]
  precos          TabelaPreco[]
  itensProposta   ItemProposta[]
  precosKg        PrecoKgAluminio[]
  criadoEm        DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model AcabamentoAluminio {
  id              String            @id @default(cuid())
  nome            String            @unique
  ativo           Boolean           @default(true)
  ordem           Int               @default(0)
  produtos        Produto[]
  precos          TabelaPreco[]
  itensProposta   ItemProposta[]
  precosKg        PrecoKgAluminio[]
  criadoEm        DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model TipoVidro {
  id              String         @id @default(cuid())
  nome            String         @unique
  ativo           Boolean        @default(true)
  ordem           Int            @default(0)
  precos          TabelaPreco[]
  itensProposta   ItemProposta[]
  itensCompra     ItemCompra[]
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model EspessuraVidro {
  id              String    @id @default(cuid())
  /// Espessura em milímetros (ex.: 6, 8, 10).
  mm              Int       @unique
  ativo           Boolean   @default(true)
  ordem           Int       @default(0)
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model CategoriaProduto {
  id              String       @id @default(cuid())
  nome            String       @unique
  ativo           Boolean      @default(true)
  ordem           Int          @default(0)
  produtos        Produto[]
  fornecedores    Fornecedor[]
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model MotivoPerda {
  id              String     @id @default(cuid())
  nome            String     @unique
  ativo           Boolean    @default(true)
  ordem           Int        @default(0)
  projetos        Projeto[]
  propostas       Proposta[]
  criadoEm        DateTime   @default(now())
  atualizadoEm    DateTime   @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model MotivoBloqueio {
  id              String         @id @default(cuid())
  nome            String         @unique
  /// Pausa justificada (não imputável à Pontual) estende o prazo prometido (R8).
  justificado     Boolean        @default(true)
  ativo           Boolean        @default(true)
  ordem           Int            @default(0)
  etapasProjeto   EtapaProjeto[]
  pausasProjeto   PausaProjeto[]
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model CategoriaFinanceira {
  id              String                  @id @default(cuid())
  nome            String
  tipo            TipoCategoriaFinanceira
  /// Grupo usado no DRE gerencial.
  grupoDre        String?
  /// Grupo do DRE (lista fixa). Preenchido a partir do texto `grupoDre` na migração da Fase 5.
  grupo           GrupoDre?
  lancamentos     Lancamento[]
  contasPagar     ContaPagar[]
  recorrencias    RecorrenciaPagar[]
  contasReceber   ContaReceber[]
  ativo           Boolean                 @default(true)
  ordem           Int                     @default(0)
  criadoEm        DateTime                @default(now())
  atualizadoEm    DateTime                @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@unique([tipo, nome])
}

// ===================== Cadastros (Fase 1) =====================

model Cliente {
  id               String          @id @default(cuid())
  tipoPessoa       TipoPessoa      @default(PF)
  /// Nome (PF) ou razão social (PJ).
  nome             String
  nomeFantasia     String?
  /// Só dígitos (CPF com 11 ou CNPJ com 14). Duplicidade é avisada na tela, não imposta no banco.
  cpfCnpj          String?
  /// E.164 ("+5522999583288").
  telefone         String?
  whatsapp         String?
  email            String?
  // Marcações combináveis (R18).
  clienteFinal     Boolean         @default(true)
  arquiteto        Boolean         @default(false)
  construtora      Boolean         @default(false)
  empresa          Boolean         @default(false)
  origem           OrigemContato?
  origemDetalhe    String?
  indicadoPorId    String?
  indicadoPor      Cliente?        @relation("Indicacao", fields: [indicadoPorId], references: [id], onDelete: Restrict)
  indicados        Cliente[]       @relation("Indicacao")
  observacoes      String?
  ativo            Boolean         @default(true)
  loteImportacaoId String?
  loteImportacao   LoteImportacao? @relation(fields: [loteImportacaoId], references: [id], onDelete: Restrict)

  enderecos               EnderecoCliente[]
  contatos                ContatoCliente[]
  interacoes              Interacao[]
  tarefas                 Tarefa[]
  projetos                Projeto[]         @relation("ProjetoCliente")
  projetosComoArquiteto   Projeto[]         @relation("ProjetoArquiteto")
  projetosComoConstrutora Projeto[]         @relation("ProjetoConstrutora")
  eventosAgenda           EventoAgenda[]

  contasReceber   ContaReceber[]
  chamados        Chamado[]
  lancamentos     Lancamento[]
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, ativo, nome])
  @@index([cpfCnpj])
  @@index([telefone])
  @@index([whatsapp])
  @@index([arquiteto])
  @@index([construtora])
  @@index([indicadoPorId])
  @@index([loteImportacaoId])
}

model EnderecoCliente {
  id                    String         @id @default(cuid())
  clienteId             String
  cliente               Cliente        @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  tipo                  TipoEndereco   @default(OBRA)
  apelido               String?
  logradouro            String?
  numero                String?
  complemento           String?
  bairro                String?
  cidade                String?
  uf                    String?
  cep                   String?
  // Condomínio (R9): exige aprovação da fachada, horários permitidos, contato do síndico.
  condominio            Boolean        @default(false)
  condominioNome        String?
  exigeAprovacaoFachada Boolean        @default(false)
  fachadaAprovada       Boolean        @default(false)
  horariosPermitidos    String?
  sindicoNome           String?
  sindicoTelefone       String?
  projetos              Projeto[]
  eventosAgenda         EventoAgenda[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([clienteId, deletadoEm])
}

model ContatoCliente {
  id          String  @id @default(cuid())
  clienteId   String
  cliente     Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  nome        String
  cargo       String?
  telefone    String?
  whatsapp    String?
  email       String?
  observacoes String?

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([clienteId, deletadoEm])
}

model Fornecedor {
  id                 String             @id @default(cuid())
  razaoSocial        String
  nomeFantasia       String?
  cnpj               String?
  categorias         CategoriaProduto[]
  vendedorNome       String?
  telefone           String?
  email              String?
  condicoesPagamento String?
  prazoEntregaDias   Int?
  observacoes        String?
  ativo              Boolean            @default(true)
  loteImportacaoId   String?
  loteImportacao     LoteImportacao?    @relation(fields: [loteImportacaoId], references: [id], onDelete: Restrict)
  produtos           Produto[]
  historicoPrecos    HistoricoPreco[]
  lancamentos        Lancamento[]
  contasPagar        ContaPagar[]
  recorrencias       RecorrenciaPagar[]

  compras         Compra[]
  precosKg        PrecoKgAluminio[]
  criadoEm        DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, ativo, razaoSocial])
  @@index([cnpj])
  @@index([loteImportacaoId])
}

model Funcionario {
  id                  String             @id @default(cuid())
  nome                String
  cpf                 String?
  telefone            String?
  email               String?
  cargo               String?
  funcao              FuncaoFuncionario
  admissaoEm          DateTime?          @db.Date
  demissaoEm          DateTime?          @db.Date
  salarioBaseCentavos Int?
  custoHoraCentavos   Int?
  observacoes         String?
  ativo               Boolean            @default(true)
  usuarioId           String?            @unique
  usuario             Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  equipes             EquipeMembro[]
  contasPagar         ContaPagar[]
  recorrencias        RecorrenciaPagar[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, ativo, nome])
  @@index([cpf])
}

model Equipe {
  id            String         @id @default(cuid())
  nome          String
  descricao     String?
  ativo         Boolean        @default(true)
  membros       EquipeMembro[]
  eventosAgenda EventoAgenda[]
  etapasProjeto EtapaProjeto[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, ativo, nome])
}

/// Ao tirar alguém da equipe, `deletadoEm` é preenchido; ao recolocar, é limpo (a unicidade vale sempre).
model EquipeMembro {
  id            String      @id @default(cuid())
  equipeId      String
  equipe        Equipe      @relation(fields: [equipeId], references: [id], onDelete: Restrict)
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)
  lider         Boolean     @default(false)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@unique([equipeId, funcionarioId])
  @@index([funcionarioId])
}

model Produto {
  id                    String              @id @default(cuid())
  /// Único entre os não excluídos (índice parcial criado na migração).
  codigo                String
  descricao             String
  categoriaId           String?
  categoria             CategoriaProduto?   @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  unidade               UnidadeProduto      @default(UN)
  linhaId               String?
  linha                 LinhaAluminio?      @relation(fields: [linhaId], references: [id], onDelete: Restrict)
  acabamentoId          String?
  acabamento            AcabamentoAluminio? @relation(fields: [acabamentoId], references: [id], onDelete: Restrict)
  fornecedorPrincipalId String?
  fornecedorPrincipal   Fornecedor?         @relation(fields: [fornecedorPrincipalId], references: [id], onDelete: Restrict)
  /// Vazio = custo ainda não informado (nunca inventamos preço).
  custoUnitarioCentavos Int?
  custoAtualizadoEm     DateTime?
  comprimentoBarraMm    Int?
  pesoKgPorMetro        Decimal?            @db.Decimal(8, 3)
  /// Só para produto acabado de pronta entrega.
  larguraMm             Int?
  alturaMm              Int?
  /// Vazio = sem alerta de estoque mínimo (R14).
  estoqueMinimo         Decimal?            @db.Decimal(12, 3)
  localizacao           String?
  observacoes           String?
  ativo                 Boolean             @default(true)
  loteImportacaoId      String?
  loteImportacao        LoteImportacao?     @relation(fields: [loteImportacaoId], references: [id], onDelete: Restrict)
  historicoPrecos       HistoricoPreco[]

  insumosComposicao ComposicaoInsumo[]
  /// Perfil cujo custo nasce do preço do kg do acabamento (Fase 6). Peso por metro e comprimento da barra continuam nos campos acima.
  custoPorKg        Boolean            @default(false)
  /// Cache da soma dos movimentos de estoque, atualizado na mesma transação do movimento (R14).
  saldoCache        Decimal            @default(0) @db.Decimal(12, 3)
  movimentosEstoque MovimentoEstoque[]
  retalhos          Retalho[]
  movimentosSucata  MovimentoSucata[]
  itensCompra       ItemCompra[]
  criadoEm          DateTime           @default(now())
  atualizadoEm      DateTime           @updatedAt
  criadoPorId       String?
  atualizadoPorId   String?
  deletadoEm        DateTime?

  @@index([deletadoEm, ativo, descricao])
  @@index([categoriaId])
  @@index([linhaId])
  @@index([fornecedorPrincipalId])
  @@index([loteImportacaoId])
}

/// Toda mudança de custo de um produto (R13). Só se acrescenta; nunca se edita.
model HistoricoPreco {
  id                    String          @id @default(cuid())
  produtoId             String
  produto               Produto         @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  custoAnteriorCentavos Int?
  custoNovoCentavos     Int
  origem                OrigemPreco
  fornecedorId          String?
  fornecedor            Fornecedor?     @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  usuarioId             String?
  loteImportacaoId      String?
  loteImportacao        LoteImportacao? @relation(fields: [loteImportacaoId], references: [id], onDelete: Restrict)
  /// Descrição curta do reajuste em lote ("+5% — Fornecedor X").
  observacao            String?

  compraId        String?
  compra          Compra?   @relation(fields: [compraId], references: [id], onDelete: Restrict)
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([produtoId, criadoEm])
  @@index([loteImportacaoId])
}

model LoteImportacao {
  id              String               @id @default(cuid())
  tipo            TipoImportacao
  nomeArquivo     String
  totalLinhas     Int
  criados         Int                  @default(0)
  atualizados     Int                  @default(0)
  ignorados       Int                  @default(0)
  status          StatusLoteImportacao @default(APLICADO)
  revertidoEm     DateTime?
  revertidoPorId  String?
  itens           LoteImportacaoItem[]
  clientes        Cliente[]
  fornecedores    Fornecedor[]
  produtos        Produto[]
  historicoPrecos HistoricoPreco[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([tipo, criadoEm])
}

/// O que cada lote fez, para poder reverter: criados vão para a lixeira; atualizados voltam ao `antes`.
model LoteImportacaoItem {
  id         String         @id @default(cuid())
  loteId     String
  lote       LoteImportacao @relation(fields: [loteId], references: [id], onDelete: Restrict)
  entidadeId String
  acao       AcaoLoteItem
  /// Valores anteriores (só quando ATUALIZADO).
  antes      Json?

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([loteId])
}

/// Filtros salvos por usuário e tela (spec 7: "todas as listas ... com filtros salvos").
model FiltroSalvo {
  id        String @id @default(cuid())
  usuarioId String
  /// Identificador da lista ("clientes", "produtos"...).
  tela      String
  nome      String
  /// Query string da lista, sem o "?" e sem a página.
  consulta  String

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@unique([usuarioId, tela, nome])
}

// ===================== Fase 2 (Comercial: funil e agenda) =====================

/// Fases do projeto (spec seção 6). APROVADO só é alcançado pela aprovação de proposta (Fase 3).
enum StatusProjeto {
  NOVO_LEAD
  VISITA_AGENDADA
  ELABORANDO_PROPOSTA
  PROPOSTA_ENVIADA
  NEGOCIACAO
  APROVADO
  EM_EXECUCAO
  CONCLUIDO
  PERDIDO
  CANCELADO
}

enum PorteProjeto {
  PEQUENO
  MEDIO
  GRANDE
}

enum InteresseProjeto {
  COMPRA_REAL
  SO_ORCAMENTO_ESPECULACAO
  INDEFINIDO
}

enum TemperaturaProjeto {
  FRIA
  MORNA
  QUENTE
}

/// Fase da obra do cliente (R9).
enum FaseObraCliente {
  PLANTA
  EM_CONSTRUCAO
  PRONTA
}

enum TipoServico {
  JANELA
  PORTA
  BOX
  GUARDA_CORPO
  FECHAMENTO_SACADA
  PORTAO
  PERGOLADO
  ESPELHO
  OUTRO
}

enum TipoEventoAgenda {
  VISITA_TECNICA
  MEDICAO_EXATA
  MEDICAO_VIDROS
  INSTALACAO
  ENTREGA
  ASSISTENCIA
  REUNIAO
}

enum StatusEventoAgenda {
  AGENDADO
  CONFIRMADO
  REALIZADO
  REMARCADO
  CANCELADO
  NAO_COMPARECEU
}

/// `Projeto` é a entidade única do ciclo inteiro (comercial → obra). Dinheiro em centavos.
/// Os campos de prazo (Fase 4) são preenchidos na aprovação (copiados da proposta aprovada) e ajustáveis na obra.
model Projeto {
  id                           String              @id @default(cuid())
  /// P-AAAA-NNNN (contador anual em ContadorSequencia).
  codigo                       String              @unique
  titulo                       String
  clienteId                    String
  cliente                      Cliente             @relation("ProjetoCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  enderecoObraId               String?
  enderecoObra                 EnderecoCliente?    @relation(fields: [enderecoObraId], references: [id], onDelete: Restrict)
  arquitetoId                  String?
  arquiteto                    Cliente?            @relation("ProjetoArquiteto", fields: [arquitetoId], references: [id], onDelete: Restrict)
  construtoraId                String?
  construtora                  Cliente?            @relation("ProjetoConstrutora", fields: [construtoraId], references: [id], onDelete: Restrict)
  responsavelId                String?
  responsavel                  Usuario?            @relation(fields: [responsavelId], references: [id], onDelete: Restrict)
  status                       StatusProjeto       @default(NOVO_LEAD)
  tiposServico                 TipoServico[]
  origem                       OrigemContato?
  origemDetalhe                String?
  canal                        String?
  porte                        PorteProjeto?
  interesse                    InteresseProjeto    @default(INDEFINIDO)
  temperatura                  TemperaturaProjeto?
  faseDaObra                   FaseObraCliente?
  investimentoPrevistoCentavos Int?
  valorEstimadoCentavos        Int?
  /// Texto livre ("até março", "antes do Natal").
  prazoDesejado                String?
  motivoPerdaId                String?
  motivoPerda                  MotivoPerda?        @relation(fields: [motivoPerdaId], references: [id], onDelete: Restrict)
  motivoPerdaDetalhe           String?
  /// Quando o motivo é "escolheu concorrente": qual (opcional).
  concorrente                  String?
  /// Preenchido pela IA de atendimento no futuro (spec seção 6).
  resumoAtendimento            String?
  observacoes                  String?
  perdidoEm                    DateTime?
  /// Soma das propostas aprovadas (R5). Vazio até a primeira aprovação.
  valorFechadoCentavos         Int?
  dataFechamento               DateTime?
  /// Última mudança de fase: base de "dias parado" e da lista "Sem retorno".
  ultimaMovimentacaoEm         DateTime            @default(now())

  // ----- Obra (Fase 4: R7/R8) -----
  /// Como o prazo foi prometido (copiado da proposta aprovada): total simples ou por grupo de etapas.
  prazoModo            ModoPrazo @default(NENHUM)
  /// Total de dias que vale para o prazo final: no modo total simples ("20 a 35 dias") o MÁXIMO (R7);
  /// no modo por etapa, a soma dos três grupos.
  prazoDias            Int?
  prazoMaterialDias    Int?
  prazoExecucaoDias    Int?
  prazoVidrosDias      Int?
  /// Dias úteis (padrão) ou corridos, como estava na proposta no momento do envio.
  tipoDiasPrazo        TipoDias  @default(UTEIS)
  /// O relógio começa na conclusão da MEDICAO_EXATA (R8). Vazio = prazo ainda provisório.
  dataInicioPrazo      DateTime? @db.Date
  prazoFinalPrometido  DateTime? @db.Date
  /// Cache da soma dos dias de pausas justificadas (a fonte são as linhas de PausaProjeto).
  diasPausaJustificada Int       @default(0)
  /// Gravada quando a etapa ENTREGA é concluída.
  dataConclusao        DateTime? @db.Date
  /// Autorização para usar as fotos no portfólio (R18): padrão sim, o gestor pode desmarcar por obra.
  autorizaPortfolio    Boolean   @default(true)
  /// Marca "já publicada no Instagram" (galeria, 7.8) para não repetir.
  publicadoInstagramEm DateTime? @db.Date

  tarefas        Tarefa[]
  interacoes     Interacao[]
  eventos        EventoAgenda[]
  medidas        MedidaRascunho[]
  historicoFases HistoricoFaseProjeto[]
  propostas      Proposta[]
  contasReceber  ContaReceber[]
  lancamentos    Lancamento[]
  contasPagar    ContaPagar[]
  etapas         EtapaProjeto[]
  pausas         PausaProjeto[]
  chamados       Chamado[]

  movimentosEstoque  MovimentoEstoque[]
  retalhosDeOrigem   Retalho[]          @relation("RetalhoOrigem")
  retalhosConsumidos Retalho[]          @relation("RetalhoConsumo")
  movimentosSucata   MovimentoSucata[]
  compras            Compra[]
  criadoEm           DateTime           @default(now())
  atualizadoEm       DateTime           @updatedAt
  criadoPorId        String?
  atualizadoPorId    String?
  deletadoEm         DateTime?

  @@index([deletadoEm, status, ultimaMovimentacaoEm])
  @@index([clienteId])
  @@index([responsavelId, status])
  @@index([origem])
  @@index([arquitetoId])
  @@index([construtoraId])
  @@index([criadoEm])
  @@index([status, prazoFinalPrometido])
}

/// Cada mudança de fase (alimenta conversão por fase e "tempo visita → proposta enviada").
model HistoricoFaseProjeto {
  id          String         @id @default(cuid())
  projetoId   String
  projeto     Projeto        @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  /// Vazio na criação do projeto.
  de          StatusProjeto?
  para        StatusProjeto
  criadoEm    DateTime       @default(now())
  criadoPorId String?

  @@index([projetoId, criadoEm])
  @@index([para, criadoEm])
}

/// Visitas, medições, instalações, entregas e assistências. Instantes em UTC; exibição em America/Sao_Paulo.
model EventoAgenda {
  id             String             @id @default(cuid())
  tipo           TipoEventoAgenda
  titulo         String?
  inicio         DateTime
  fim            DateTime
  responsavelId  String?
  responsavel    Usuario?           @relation(fields: [responsavelId], references: [id], onDelete: Restrict)
  equipeId       String?
  equipe         Equipe?            @relation(fields: [equipeId], references: [id], onDelete: Restrict)
  clienteId      String?
  cliente        Cliente?           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  projetoId      String?
  projeto        Projeto?           @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  enderecoId     String?
  endereco       EnderecoCliente?   @relation(fields: [enderecoId], references: [id], onDelete: Restrict)
  /// Local em texto (cópia do endereço da obra no momento do agendamento ou digitado).
  local          String?
  status         StatusEventoAgenda @default(AGENDADO)
  /// Minutos de antecedência do lembrete (ex.: 1440 = 24 h). Vazio = sem lembrete.
  lembreteMin    Int?
  observacoes    String?
  realizadoEm    DateTime?
  /// Etapa da obra que este agendamento cumpre (ex.: instalação) — calendário de instalação (Fase 4).
  etapaProjetoId String?
  etapaProjeto   EtapaProjeto?      @relation(fields: [etapaProjetoId], references: [id], onDelete: Restrict)
  /// Chamado de assistência que este agendamento atende (Fase 4).
  chamadoId      String?
  chamado        Chamado?           @relation(fields: [chamadoId], references: [id], onDelete: Restrict)
  medidas        MedidaRascunho[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([etapaProjetoId])
  @@index([chamadoId])
  @@index([deletadoEm, inicio])
  @@index([responsavelId, inicio])
  @@index([equipeId, inicio])
  @@index([projetoId])
  @@index([clienteId])
  @@index([status, inicio])
}

/// Medidas anotadas na visita (R9). Fotos ficam em `Anexo` (entidadeTipo = "MedidaRascunho").
model MedidaRascunho {
  id         String        @id @default(cuid())
  projetoId  String
  projeto    Projeto       @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  eventoId   String?
  evento     EventoAgenda? @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  ambiente   String?
  /// Texto livre por ora; vira vínculo com Tipologia na Fase 3.
  tipologia  String?
  larguraMm  Int?
  alturaMm   Int?
  quantidade Int           @default(1)
  observacao String?
  ordem      Int           @default(0)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([projetoId, deletadoEm, ordem])
  @@index([eventoId])
}

/// Feed .ics assinável por token secreto (só o hash é guardado) e revogável.
model FeedAgenda {
  id             String    @id @default(cuid())
  usuarioId      String
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  nome           String?
  /// SHA-256 (hex) do token. O token em claro é mostrado uma única vez.
  tokenHash      String    @unique
  ultimoAcessoEm DateTime?
  revogadoEm     DateTime?

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([usuarioId, revogadoEm])
}

/// Contadores sequenciais transacionais (ex.: "projeto:2026"). Reaproveitável pelas propostas (Fase 3).
model ContadorSequencia {
  chave        String   @id
  valor        Int      @default(0)
  atualizadoEm DateTime @updatedAt
}

// ===================== Fase 3 (Propostas) =====================
// Dinheiro em centavos (Int). Percentuais NOVOS em pontos-base inteiros (`...Pb`: 1% = 100; 5% = 500),
// para nunca usar ponto flutuante. Regras do dono (docs/DECISOES.md, 57+): vendas com ou sem nota fiscal;
// com nota soma-se o acréscimo (padrão 5%) sobre o preço, em linha separada.

enum TipoCobranca {
  POR_M2
  POR_UNIDADE
  POR_METRO_LINEAR
}

enum CategoriaMarkup {
  PADRAO
  VIDRO_TEMPERADO
}

enum ModoPreco {
  MANUAL
  TABELA
  COMPOSICAO
}

enum TipoDesenho {
  JANELA_CORRER
  PORTA_CORRER
  BASCULA
  PAINEL_FIXO
  PORTA_GIRO
  BOX_FRONTAL
  GUARDA_CORPO
  FECHAMENTO_SACADA
  PORTAO
  PERGOLADO
  ESPELHO
  GENERICO
}

enum PapelMaoDeObra {
  FABRICA
  INSTALACAO
}

enum BaseMaoDeObra {
  HORAS_POR_M2
  HORAS_POR_UNIDADE
}

enum StatusProposta {
  RASCUNHO
  ENVIADA
  APROVADA
  RECUSADA
  EXPIRADA
  SUBSTITUIDA
  CANCELADA
}

enum ModoPrazo {
  NENHUM
  TOTAL
  POR_ETAPA
}

enum FormaAceite {
  WHATSAPP
  EMAIL
  ASSINATURA
  VERBAL
}

enum GatilhoPagamento {
  CONFIRMACAO
  ENTREGA_MATERIAL
  ENTREGA_E_INSTALACAO
  DATA_FIXA
  DIAS_APOS_APROVACAO
}

enum FormaPagamento {
  PIX
  TRANSFERENCIA
  ESPECIE
  CARTAO_CREDITO
  BOLETO
}

enum StatusContaReceber {
  AGUARDANDO_GATILHO
  ABERTA
  PARCIAL
  PAGA
  CANCELADA
}

/// Tipo de janela, porta, box etc. A composição e a tabela de preços dependem dela (R1, R2).
model Tipologia {
  id                String          @id @default(cuid())
  nome              String
  categoria         TipoServico     @default(OUTRO)
  tipoDesenho       TipoDesenho     @default(GENERICO)
  /// Números de folhas oferecidos (ex.: 2, 3, 4). Vazio = sem escolha de folhas.
  opcoesFolhas      Int[]
  /// Template da descrição técnica (Apêndice B; variáveis entre chaves, plural com (S)).
  templateDescricao String
  /// Texto genérico criado por mim, sem template do Apêndice B: o Marcelo precisa conferir.
  revisarTexto      Boolean         @default(false)
  cobrancaPadrao    TipoCobranca    @default(POR_M2)
  /// Define qual markup padrão vale para os itens desta tipologia (R1).
  categoriaMarkup   CategoriaMarkup @default(PADRAO)
  exigeEsquadria    Boolean         @default(true)
  /// Tipologia de EXEMPLO (R2): desativada e marcada "validar com o Marcelo".
  exemplo           Boolean         @default(false)
  ativo             Boolean         @default(true)
  ordem             Int             @default(0)

  insumos   ComposicaoInsumo[]
  maoDeObra ComposicaoMaoDeObra[]
  precos    TabelaPreco[]
  itens     ItemProposta[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, ativo, ordem])
}

/// Insumo da composição: quantidade por fórmula em função de L, A, F, Q (interpretador seguro).
model ComposicaoInsumo {
  id                    String         @id @default(cuid())
  tipologiaId           String
  tipologia             Tipologia      @relation(fields: [tipologiaId], references: [id], onDelete: Restrict)
  produtoId             String?
  produto               Produto?       @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  /// Descrição livre quando não há produto cadastrado (o custo então precisa ser informado aqui).
  descricao             String?
  unidade               UnidadeProduto
  formulaQuantidade     String
  /// Perda de corte em pontos-base (5% = 500).
  perdaPb               Int            @default(0)
  /// Custo unitário próprio (só quando não há produto).
  custoUnitarioCentavos Int?
  ordem                 Int            @default(0)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([tipologiaId, deletadoEm, ordem])
  @@index([produtoId])
}

model ComposicaoMaoDeObra {
  id                String         @id @default(cuid())
  tipologiaId       String
  tipologia         Tipologia      @relation(fields: [tipologiaId], references: [id], onDelete: Restrict)
  papel             PapelMaoDeObra
  base              BaseMaoDeObra
  /// Horas em centésimos (1,5 h = 150).
  horasCentesimos   Int
  /// Vazio = sem custo por hora informado (o sistema avisa; nunca inventa).
  custoHoraCentavos Int?
  ordem             Int            @default(0)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([tipologiaId, deletadoEm, ordem])
}

/// Linha da tabela de preços. Coluna vazia = "qualquer"; vale a linha mais específica que combina com o item.
model TabelaPreco {
  id               String              @id @default(cuid())
  tipologiaId      String
  tipologia        Tipologia           @relation(fields: [tipologiaId], references: [id], onDelete: Restrict)
  linhaId          String?
  linha            LinhaAluminio?      @relation(fields: [linhaId], references: [id], onDelete: Restrict)
  acabamentoId     String?
  acabamento       AcabamentoAluminio? @relation(fields: [acabamentoId], references: [id], onDelete: Restrict)
  tipoVidroId      String?
  tipoVidro        TipoVidro?          @relation(fields: [tipoVidroId], references: [id], onDelete: Restrict)
  espessuraVidroMm Int?
  cobranca         TipoCobranca
  valorCentavos    Int
  vigenciaInicio   DateTime?           @db.Date
  vigenciaFim      DateTime?           @db.Date
  ativo            Boolean             @default(true)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([tipologiaId, deletadoEm, ativo])
}

/// Modelo de condição de pagamento (R6). "A combinar" = texto livre, sem parcelas.
model CondicaoPagamento {
  id         String  @id @default(cuid())
  nome       String
  descricao  String?
  /// Preenchido só nas condições sem cronograma (ex.: "A combinar").
  textoLivre String?
  ativo      Boolean @default(true)
  ordem      Int     @default(0)

  parcelas  CondicaoParcela[]
  propostas Proposta[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, ativo, ordem])
}

model CondicaoParcela {
  id             String            @id @default(cuid())
  condicaoId     String
  condicao       CondicaoPagamento @relation(fields: [condicaoId], references: [id], onDelete: Restrict)
  ordem          Int
  descricao      String
  /// Pontos-base (50% = 5000).
  percentualPb   Int
  gatilho        GatilhoPagamento
  forma          FormaPagamento?
  diasApos       Int?
  parcelasCartao Int?

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([condicaoId, deletadoEm, ordem])
}

model Proposta {
  id               String         @id @default(cuid())
  projetoId        String
  projeto          Projeto        @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  /// NNNN-AA (o número não muda entre revisões).
  numero           String
  numeroSequencial Int
  ano              Int
  revisao          Int            @default(0)
  revisaoDeId      String?
  /// Rótulo livre ("Parte 01/02").
  parte            String?
  status           StatusProposta @default(RASCUNHO)
  /// Data de emissão (calendário).
  data             DateTime       @db.Date
  consultorNome    String?
  consultorCargo   String?

  // Cabeçalho do cliente (cópia editável do projeto no momento da criação).
  clienteNome      String
  clienteDocumento String?
  clienteContato   String?
  clienteTelefone  String?
  clienteEmail     String?
  enderecoObra     String?
  tituloEscopo     String  @default("ESCOPO DO SERVIÇO")

  // Nota fiscal (regra do dono): sem nota é o padrão; com nota soma-se o acréscimo sobre o preço.
  comNotaFiscal       Boolean @default(false)
  /// Acréscimo aplicado (pontos-base), copiado de Configurações ao criar e editável.
  acrescimoNotaPb     Int     @default(500)
  /// Comissões: começam em zero e são editáveis; só informativas (não alteram o preço).
  comissaoArquitetoPb Int     @default(0)
  comissaoIndicacaoPb Int     @default(0)
  /// Markup SOBRE O CUSTO desta proposta (pontos-base: 80% = 8000); vazio = o da categoria da tipologia/Configurações.
  markupPb            Int?

  // Prazos (R7/R8). O relógio começa na medição exata.
  modoPrazo                    ModoPrazo @default(NENHUM)
  prazoTotalMinDias            Int?
  prazoTotalMaxDias            Int?
  prazoMaterialDias            Int?
  prazoExecucaoDias            Int?
  prazoVidrosDias              Int?
  validadeTexto                String?
  validadeAte                  DateTime? @db.Date
  validadeEncerradaPorReajuste Boolean   @default(false)

  // Condição de pagamento (cópia editável; as parcelas ficam em PropostaParcela).
  condicaoId           String?
  condicao             CondicaoPagamento? @relation(fields: [condicaoId], references: [id], onDelete: Restrict)
  condicaoTextoLivre   String?
  dadosPagamento       String?
  /// Cláusulas das "Notas importantes" (numeradas na impressão).
  notas                String[]
  exibirValorPorItem   Boolean            @default(true)
  descricoesMaiusculas Boolean            @default(true)
  observacoesInternas  String?

  // Ciclo de vida (R4/R5)
  enviadaEm             DateTime?
  /// Conteúdo congelado ao marcar ENVIADA (PDF e comparação de revisões leem daqui).
  snapshot              Json?
  aceitaEm              DateTime?
  formaAceite           FormaAceite?
  aceiteObservacao      String?
  aceiteAnexoId         String?
  opcaoAprovadaId       String?
  valorAprovadoCentavos Int?
  recusadaEm            DateTime?
  motivoPerdaId         String?
  motivoPerda           MotivoPerda? @relation(fields: [motivoPerdaId], references: [id], onDelete: Restrict)
  motivoRecusaDetalhe   String?

  opcoes        OpcaoProposta[]
  grupos        GrupoProposta[]
  itens         ItemProposta[]
  parcelas      PropostaParcela[]
  contasReceber ContaReceber[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@unique([numero, revisao])
  @@index([projetoId, deletadoEm, status])
  @@index([status, enviadaEm])
  @@index([numeroSequencial])
  @@index([criadoEm])
}

model OpcaoProposta {
  id               String         @id @default(cuid())
  propostaId       String
  proposta         Proposta       @relation(fields: [propostaId], references: [id], onDelete: Restrict)
  /// Ex.: "LINHA SUPREMA", "LINHA GOLD". Com uma só opção o nome não aparece no PDF.
  nome             String
  ordem            Int            @default(0)
  /// Desconto desta opção (centavos); vale antes do acréscimo da nota.
  descontoCentavos Int            @default(0)
  itens            ItemProposta[]

  /// Custo de material informado à mão (vindo do programa de corte do fornecedor), total da opção. SÓ interno: nunca entra no snapshot nem no PDF.
  custoMaterialInformadoCentavos Int?
  criadoEm                       DateTime  @default(now())
  atualizadoEm                   DateTime  @updatedAt
  criadoPorId                    String?
  atualizadoPorId                String?
  deletadoEm                     DateTime?

  @@index([propostaId, deletadoEm, ordem])
}

model GrupoProposta {
  id         String         @id @default(cuid())
  propostaId String
  proposta   Proposta       @relation(fields: [propostaId], references: [id], onDelete: Restrict)
  /// Ex.: "PARTE SUPERIOR", "ESCADA".
  nome       String
  ordem      Int            @default(0)
  itens      ItemProposta[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([propostaId, deletadoEm, ordem])
}

model ItemProposta {
  id                    String               @id @default(cuid())
  propostaId            String
  proposta              Proposta             @relation(fields: [propostaId], references: [id], onDelete: Restrict)
  opcaoId               String
  opcao                 OpcaoProposta        @relation(fields: [opcaoId], references: [id], onDelete: Restrict)
  grupoId               String?
  grupo                 GrupoProposta?       @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  /// A numeração do item é automática (posição dentro da opção).
  ordem                 Int                  @default(0)
  tipologiaId           String?
  tipologia             Tipologia?           @relation(fields: [tipologiaId], references: [id], onDelete: Restrict)
  linhaId               String?
  linha                 LinhaAluminio?       @relation(fields: [linhaId], references: [id], onDelete: Restrict)
  acabamentoId          String?
  acabamento            AcabamentoAluminio?  @relation(fields: [acabamentoId], references: [id], onDelete: Restrict)
  tipoVidroId           String?
  tipoVidro             TipoVidro?           @relation(fields: [tipoVidroId], references: [id], onDelete: Restrict)
  espessuraVidroMm      Int?
  folhas                Int?
  faces                 Int?
  torresCm              Int?
  /// Descrição técnica; `descricaoEditada` = a pessoa mexeu, então não é regerada sozinha.
  descricao             String
  descricaoEditada      Boolean              @default(false)
  local                 String?
  observacoes           String?
  /// Configuração do desenho (ex.: sentido de abertura); vazio = padrão da tipologia.
  desenhoConfig         Json?
  modoPreco             ModoPreco            @default(MANUAL)
  cobranca              TipoCobranca?
  /// Valor digitado (modo MANUAL).
  valorManualCentavos   Int?
  /// Preço total do item (resultado do modo escolhido; sempre calculado pelo servidor).
  precoTotalCentavos    Int                  @default(0)
  custoEstimadoCentavos Int?
  /// Markup só deste item (composição), sobre o custo, em pontos-base; vazio = o da proposta/categoria/Configurações.
  markupPb              Int?
  /// Quando o custo/preço foi calculado (R13: "custo desatualizado desde a emissão").
  calculadoEm           DateTime?
  /// Aviso do cálculo (ex.: "Sem linha na tabela de preços: usando valor manual").
  avisoPreco            String?
  medidas               ItemPropostaMedida[]

  /// Custo de material informado à mão (do programa de corte) para este item. SÓ interno: nunca entra no snapshot nem no PDF.
  custoMaterialInformadoCentavos Int?
  itensCompra                    ItemCompra[]
  criadoEm                       DateTime     @default(now())
  atualizadoEm                   DateTime     @updatedAt
  criadoPorId                    String?
  atualizadoPorId                String?
  deletadoEm                     DateTime?

  @@index([propostaId, deletadoEm, ordem])
  @@index([opcaoId, deletadoEm, ordem])
  @@index([grupoId])
  @@index([tipologiaId])
}

model ItemPropostaMedida {
  id         String       @id @default(cuid())
  itemId     String
  item       ItemProposta @relation(fields: [itemId], references: [id], onDelete: Restrict)
  larguraMm  Int
  alturaMm   Int
  quantidade Int          @default(1)
  local      String?
  ordem      Int          @default(0)

  itensCompra     ItemCompra[]
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([itemId, deletadoEm, ordem])
}

/// Cronograma de pagamento desta proposta (cópia editável da condição escolhida).
model PropostaParcela {
  id             String           @id @default(cuid())
  propostaId     String
  proposta       Proposta         @relation(fields: [propostaId], references: [id], onDelete: Restrict)
  ordem          Int
  descricao      String
  percentualPb   Int
  gatilho        GatilhoPagamento
  forma          FormaPagamento?
  diasApos       Int?
  dataFixa       DateTime?        @db.Date
  parcelasCartao Int?

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([propostaId, deletadoEm, ordem])
}

/// Parcela a receber gerada na aprovação (R5/R6). As telas e os pagamentos entram na Fase 5.
/// "Atrasada" é derivada (vencimento < hoje e não paga), nunca gravada.
model ContaReceber {
  id                    String               @id @default(cuid())
  projetoId             String
  projeto               Projeto              @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  propostaId            String?
  proposta              Proposta?            @relation(fields: [propostaId], references: [id], onDelete: Restrict)
  clienteId             String
  cliente               Cliente              @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  /// Posição da parcela no cronograma (junto com a proposta, evita gerar em duplicidade).
  ordem                 Int
  descricao             String
  valorCentavos         Int
  /// Cache da soma dos recebimentos (lançamentos) não estornados; atualizado na mesma transação (Fase 5).
  valorPagoCentavos     Int                  @default(0)
  percentualPb          Int?
  /// Vazio enquanto aguarda a etapa (AGUARDANDO_GATILHO).
  vencimento            DateTime?            @db.Date
  gatilho               GatilhoPagamento?
  forma                 FormaPagamento?
  parcelasCartao        Int?
  status                StatusContaReceber   @default(ABERTA)
  /// Recebimento COM nota fiscal (regra do dono): herda da proposta e pode mudar no recebimento (Fase 5).
  comNotaFiscal         Boolean              @default(false)
  observacao            String?
  /// Etapa cuja conclusão abriu a parcela (gatilho, Fase 4). Vazio enquanto aguarda ou se não era por etapa.
  etapaProjetoId        String?
  etapaProjeto          EtapaProjeto?        @relation(fields: [etapaProjetoId], references: [id], onDelete: Restrict)
  chamado               Chamado?
  /// Categoria sugerida/escolhida para a receita (Fase 5); o recebimento pode trocá-la.
  categoriaFinanceiraId String?
  categoriaFinanceira   CategoriaFinanceira? @relation(fields: [categoriaFinanceiraId], references: [id], onDelete: Restrict)
  /// Data que o cliente prometeu pagar ("pediu até o dia X", Fase 6). Só alimenta o fluxo projetado: o `vencimento` original
  /// nunca muda por causa dela e continua mandando no atraso, no aging e na inadimplência.
  dataPrometida         DateTime?            @db.Date
  lancamentos           Lancamento[]
  prorrogacoes          ProrrogacaoReceber[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@unique([propostaId, ordem])
  @@index([etapaProjetoId])
  @@index([projetoId, deletadoEm])
  @@index([status, vencimento])
  @@index([clienteId])
}

/// Histórico (só se acrescenta) das vezes em que o cliente pediu mais prazo para uma parcela (Fase 6).
model ProrrogacaoReceber {
  id             String       @id @default(cuid())
  contaReceberId String
  contaReceber   ContaReceber @relation(fields: [contaReceberId], references: [id], onDelete: Restrict)
  /// Promessa anterior (vazio na primeira vez).
  dataAnterior   DateTime?    @db.Date
  dataPrometida  DateTime     @db.Date
  observacao     String?

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([contaReceberId, criadoEm])
}

// ===================== Fase 4 (Obras) =====================
// Etapas (R7), prazo e pausas (R8), assistência e garantia (R12). Datas de calendário em `@db.Date`.
// Nenhuma duração de etapa é gravada aqui: os dias vêm da proposta (nunca inventados).

enum TipoEtapa {
  MEDICAO_EXATA
  PEDIDO_MATERIAL
  FABRICACAO
  INSTALACAO_ESQUADRIAS
  MEDICAO_VIDROS
  PEDIDO_VIDROS
  INSTALACAO_VIDROS
  ACABAMENTO
  ENTREGA
  /// Etapa extra que o gestor acrescenta ao modelo.
  OUTRA
}

enum StatusEtapa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  BLOQUEADA
  /// Não se aplica a esta obra (ex.: sem esquadria). Não recebe prazo e não atrasa.
  DISPENSADA
}

/// Os três prazos impressos nas propostas (R7).
enum GrupoPrazo {
  MATERIAL
  EXECUCAO
  VIDROS_FINALIZACAO
}

enum TipoProblemaChamado {
  REGULAGEM
  VIDRO
  OUTRO
}

enum ClassificacaoChamado {
  EM_GARANTIA
  FORA_DA_GARANTIA
}

enum StatusChamado {
  ABERTO
  AGENDADO
  EM_ATENDIMENTO
  RESOLVIDO
  CANCELADO
}

/// Modelo de etapas (R7), editável em Configurações. Só um modelo é o padrão (índice parcial na migração).
model ModeloEtapas {
  id     String            @id @default(cuid())
  nome   String
  padrao Boolean           @default(false)
  ativo  Boolean           @default(true)
  itens  ModeloEtapaItem[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model ModeloEtapaItem {
  id             String            @id @default(cuid())
  modeloId       String
  modelo         ModeloEtapas      @relation(fields: [modeloId], references: [id], onDelete: Restrict)
  tipo           TipoEtapa
  nome           String
  ordem          Int
  /// Vazio = fora dos três prazos (é o caso do marco MEDICAO_EXATA, que inicia o relógio).
  grupoPrazo     GrupoPrazo?
  /// Peso dentro do grupo ao distribuir os dias entre as etapas (padrão: iguais).
  peso           Int               @default(1)
  /// Concluir esta etapa libera as parcelas com este gatilho (R6). Um item por gatilho em cada modelo.
  liberaGatilho  GatilhoPagamento?
  /// Marco do início da garantia de regulagem (R12). Um por modelo.
  marcoGarantia  Boolean           @default(false)
  /// Etapa que só existe se algum item aprovado exige esquadria (Tipologia.exigeEsquadria).
  exigeEsquadria Boolean           @default(false)
  ativo          Boolean           @default(true)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([modeloId, ordem])
}

/// Etapa de uma obra. Nome, grupo, peso, gatilho e marco são COPIADOS do modelo ao gerar: mudar o modelo
/// depois não altera obras que já existem.
model EtapaProjeto {
  id               String            @id @default(cuid())
  projetoId        String
  projeto          Projeto           @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  tipo             TipoEtapa
  nome             String
  ordem            Int
  grupoPrazo       GrupoPrazo?
  peso             Int               @default(1)
  liberaGatilho    GatilhoPagamento?
  marcoGarantia    Boolean           @default(false)
  status           StatusEtapa       @default(PENDENTE)
  responsavelId    String?
  responsavel      Usuario?          @relation(fields: [responsavelId], references: [id], onDelete: Restrict)
  equipeId         String?
  equipe           Equipe?           @relation(fields: [equipeId], references: [id], onDelete: Restrict)
  inicioPrevisto   DateTime?         @db.Date
  fimPrevisto      DateTime?         @db.Date
  /// Data calculada antes de a medição exata ser concluída (R8): a tela avisa que ainda não é definitiva.
  provisoria       Boolean           @default(false)
  inicioReal       DateTime?         @db.Date
  fimReal          DateTime?         @db.Date
  motivoBloqueioId String?
  motivoBloqueio   MotivoBloqueio?   @relation(fields: [motivoBloqueioId], references: [id], onDelete: Restrict)
  detalheBloqueio  String?
  observacao       String?

  eventos       EventoAgenda[]
  contasReceber ContaReceber[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([projetoId, ordem])
  @@index([status, fimPrevisto])
  @@index([equipeId, inicioPrevisto])
}

/// Pausa da obra (R8). Se `justificada` (motivo não imputável à Pontual), estende o prazo prometido.
/// `fim` vazio = pausa em curso (conta até hoje).
model PausaProjeto {
  id               String         @id @default(cuid())
  projetoId        String
  projeto          Projeto        @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  inicio           DateTime       @db.Date
  fim              DateTime?      @db.Date
  motivoBloqueioId String
  motivoBloqueio   MotivoBloqueio @relation(fields: [motivoBloqueioId], references: [id], onDelete: Restrict)
  /// Copiada do motivo ao abrir; o gestor pode ajustar.
  justificada      Boolean
  observacao       String?

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([projetoId, inicio])
}

/// Assistência e garantia (R12). A classificação é sugerida pelo sistema e pode ser sobrescrita.
model Chamado {
  id                    String               @id @default(cuid())
  /// Sequencial legível (ContadorSequencia, chave "chamado").
  numero                Int                  @unique
  clienteId             String
  cliente               Cliente              @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  projetoId             String?
  projeto               Projeto?             @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  descricao             String
  tipoProblema          TipoProblemaChamado
  classificacaoSugerida ClassificacaoChamado
  classificacao         ClassificacaoChamado
  /// Texto mostrado ao gestor ("instalação concluída em dd/mm; regulagem até dd/mm").
  motivoClassificacao   String?
  cobrarVisita          Boolean              @default(false)
  valorCobradoCentavos  Int?
  contaReceberId        String?              @unique
  contaReceber          ContaReceber?        @relation(fields: [contaReceberId], references: [id], onDelete: Restrict)
  status                StatusChamado        @default(ABERTO)
  abertoEm              DateTime             @default(now())
  resolvidoEm           DateTime?
  solucao               String?

  eventos EventoAgenda[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([status, abertoEm])
  @@index([clienteId])
  @@index([projetoId])
}

// ===================== Fase 5 (Financeiro) =====================
// Contas financeiras, lançamentos, contas a pagar e recorrências. Dinheiro em centavos (Int); datas de
// calendário em `@db.Date`. Todo dinheiro que entra ou sai é um `Lancamento`: saldo, fluxo realizado e DRE
// (caixa) leem só dele. Atraso é sempre derivado (vencimento < hoje e saldo > 0), nunca gravado.
// Fora do escopo por decisão do dono: notas fiscais (R16) e RBT12/Simples (R17); só a marca `comNotaFiscal`.

enum TipoContaFinanceira {
  BANCO
  CAIXA
  OUTRA
}

enum TipoLancamento {
  ENTRADA
  SAIDA
}

enum StatusContaPagar {
  ABERTA
  PARCIAL
  PAGA
  CANCELADA
}

enum PeriodicidadeRecorrencia {
  MENSAL
  TRIMESTRAL
  ANUAL
}

/// Onde o dinheiro entra e sai (banco, caixa, etc.). Sem número de conta nem dado bancário sensível.
/// Nasce sem saldo: `saldoInicialInformado = false` mostra "saldo não informado" e avisa no fluxo e no DRE.
model ContaFinanceira {
  id                    String              @id @default(cuid())
  nome                  String
  tipo                  TipoContaFinanceira @default(BANCO)
  /// Saldo no INÍCIO do dia `dataSaldoInicial`. Zero e sem data enquanto não informado.
  saldoInicialCentavos  Int                 @default(0)
  saldoInicialInformado Boolean             @default(false)
  dataSaldoInicial      DateTime?           @db.Date
  ativo                 Boolean             @default(true)
  ordem                 Int                 @default(0)
  observacao            String?
  lancamentos           Lancamento[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, ativo, ordem])
}

/// Movimento de dinheiro numa conta financeira. Nunca é apagado: o estorno o marca (`estornadoEm`) e ele sai
/// de saldo, fluxo e DRE. Transferência entre contas = dois lançamentos com o mesmo `transferenciaId`.
model Lancamento {
  id                String               @id @default(cuid())
  data              DateTime             @db.Date
  tipo              TipoLancamento
  valorCentavos     Int
  contaFinanceiraId String
  contaFinanceira   ContaFinanceira      @relation(fields: [contaFinanceiraId], references: [id], onDelete: Restrict)
  /// Vazia nas transferências (fora do DRE).
  categoriaId       String?
  categoria         CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  descricao         String
  forma             FormaPagamento?
  /// Recebimento/pagamento COM nota fiscal (só a marca; o sistema não lida com notas).
  comNotaFiscal     Boolean              @default(false)
  projetoId         String?
  projeto           Projeto?             @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  clienteId         String?
  cliente           Cliente?             @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  fornecedorId      String?
  fornecedor        Fornecedor?          @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  contaReceberId    String?
  contaReceber      ContaReceber?        @relation(fields: [contaReceberId], references: [id], onDelete: Restrict)
  contaPagarId      String?
  contaPagar        ContaPagar?          @relation(fields: [contaPagarId], references: [id], onDelete: Restrict)
  transferenciaId   String?
  conciliado        Boolean              @default(false)
  conciliadoEm      DateTime?
  estornadoEm       DateTime?
  estornadoPorId    String?
  motivoEstorno     String?
  observacao        String?

  movimentosSucata MovimentoSucata[]
  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt
  criadoPorId      String?
  atualizadoPorId  String?
  deletadoEm       DateTime?

  @@index([contaFinanceiraId, data])
  @@index([data])
  @@index([categoriaId, data])
  @@index([contaReceberId])
  @@index([contaPagarId])
  @@index([transferenciaId])
  @@index([projetoId])
}

/// Conta a pagar (única, parcela de um parcelamento ou ocorrência de uma recorrência).
/// `valorPagoCentavos` é cache da soma dos lançamentos não estornados, atualizado na mesma transação.
model ContaPagar {
  id                String               @id @default(cuid())
  descricao         String
  fornecedorId      String?
  fornecedor        Fornecedor?          @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  funcionarioId     String?
  funcionario       Funcionario?         @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)
  /// Quem recebe, quando não é fornecedor nem funcionário (ex.: proprietário do imóvel).
  favorecido        String?
  categoriaId       String?
  categoria         CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  projetoId         String?
  projeto           Projeto?             @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  valorCentavos     Int
  valorPagoCentavos Int                  @default(0)
  vencimento        DateTime             @db.Date
  /// Mês de competência (sempre o dia 1), usado no DRE por competência.
  competencia       DateTime             @db.Date
  status            StatusContaPagar     @default(ABERTA)
  forma             FormaPagamento?
  parcelamentoId    String?
  parcelaNumero     Int?
  parcelaTotal      Int?
  recorrenciaId     String?
  recorrencia       RecorrenciaPagar?    @relation(fields: [recorrenciaId], references: [id], onDelete: Restrict)
  observacao        String?
  lancamentos       Lancamento[]

  /// Compra que gerou esta conta (Fase 6). O custo real da obra lê a COMPRA, nunca esta conta, para não contar o mesmo custo duas vezes.
  compraId        String?
  compra          Compra?   @relation(fields: [compraId], references: [id], onDelete: Restrict)
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  /// Uma ocorrência por mês de competência de cada recorrência: gerar de novo (cron, retry) não duplica.
  @@unique([recorrenciaId, competencia])
  @@index([status, vencimento])
  @@index([fornecedorId])
  @@index([parcelamentoId])
  @@index([categoriaId])
  @@index([projetoId])
}

/// Modelo de uma despesa que se repete (aluguel, energia, DAS, salários). As ocorrências são `ContaPagar`.
/// `geradaAte` é a última competência já gerada (o cron e a criação estendem sem duplicar).
model RecorrenciaPagar {
  id            String                   @id @default(cuid())
  descricao     String
  fornecedorId  String?
  fornecedor    Fornecedor?              @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  funcionarioId String?
  funcionario   Funcionario?             @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)
  favorecido    String?
  categoriaId   String?
  categoria     CategoriaFinanceira?     @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  valorCentavos Int
  /// Dia do mês do vencimento (1 a 31; em mês mais curto vale o último dia).
  diaVencimento Int
  periodicidade PeriodicidadeRecorrencia @default(MENSAL)
  inicio        DateTime                 @db.Date
  fim           DateTime?                @db.Date
  ativo         Boolean                  @default(true)
  forma         FormaPagamento?
  observacao    String?
  geradaAte     DateTime?                @db.Date
  ocorrencias   ContaPagar[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, ativo])
}

// ===================== Fase 6 (Estoque e compras) =====================
// Quantidades em Decimal(12,3) (milésimos); dinheiro em centavos (Int). Nunca se inventa custo, peso por metro, preço do kg,
// retalho mínimo nem estoque inicial: campo vazio = "não informado" e a margem fica "incompleta", nunca zero.

enum TipoMovimentoEstoque {
  /// Contagem inicial opcional: nunca com valor inventado (custo vazio = "sem custo").
  INVENTARIO_INICIAL
  ENTRADA_COMPRA
  SAIDA_OBRA
  /// Volta da obra para o estoque.
  DEVOLUCAO
  AJUSTE
  PERDA
}

enum StatusRetalho {
  DISPONIVEL
  CONSUMIDO
  DESCARTADO
}

enum TipoMovimentoSucata {
  GERACAO
  VENDA
  AJUSTE
}

enum TipoCompra {
  MATERIAL
  VIDRO
}

/// ESTOQUE gera entrada no estoque; OBRA é custo direto da obra, sem passar pelo estoque (caso típico dos vidros sob medida).
enum DestinoCompra {
  ESTOQUE
  OBRA
}

enum StatusCompra {
  RASCUNHO
  PEDIDO
  RECEBIDO_PARCIAL
  RECEBIDO
  CANCELADO
}

/// Preço do kg do alumínio por acabamento (e, se quiser, por linha). A linha específica vale mais que a genérica.
/// Vazio = "sem preço do kg". Único por (acabamento, linha) entre os não excluídos (índice parcial na migração).
model PrecoKgAluminio {
  id              String             @id @default(cuid())
  acabamentoId    String
  acabamento      AcabamentoAluminio @relation(fields: [acabamentoId], references: [id], onDelete: Restrict)
  linhaId         String?
  linha           LinhaAluminio?     @relation(fields: [linhaId], references: [id], onDelete: Restrict)
  fornecedorId    String?
  fornecedor      Fornecedor?        @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  custoKgCentavos Int?
  observacao      String?
  historico       HistoricoPrecoKg[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([acabamentoId])
  @@index([linhaId])
}

/// Toda mudança do preço do kg. Só se acrescenta.
model HistoricoPrecoKg {
  id                    String          @id @default(cuid())
  precoKgId             String
  precoKg               PrecoKgAluminio @relation(fields: [precoKgId], references: [id], onDelete: Restrict)
  custoAnteriorCentavos Int?
  custoNovoCentavos     Int?
  origem                OrigemPreco
  compraId              String?
  compra                Compra?         @relation(fields: [compraId], references: [id], onDelete: Restrict)
  usuarioId             String?
  observacao            String?

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([precoKgId, criadoEm])
  @@index([compraId])
}

/// Todo movimento de estoque (R14). `quantidade` tem sinal (entrada +, saída −), na unidade do produto. O saldo do produto é a
/// soma dos movimentos; `Produto.saldoCache` é atualizado na mesma transação. Estorno = movimento inverso (`estornoDeId`).
model MovimentoEstoque {
  id                    String               @id @default(cuid())
  produtoId             String
  produto               Produto              @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  tipo                  TipoMovimentoEstoque
  quantidade            Decimal              @db.Decimal(12, 3)
  /// Custo unitário congelado na data do movimento; vazio = "sem custo" (a margem da obra fica incompleta).
  custoUnitarioCentavos Int?
  data                  DateTime             @db.Date
  projetoId             String?
  projeto               Projeto?             @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  itemRecebimentoId     String?
  itemRecebimento       ItemRecebimento?     @relation(fields: [itemRecebimentoId], references: [id], onDelete: Restrict)
  /// Movimento que este desfaz (um movimento só é estornado uma vez).
  estornoDeId           String?              @unique
  estornoDe             MovimentoEstoque?    @relation("EstornoDeMovimento", fields: [estornoDeId], references: [id], onDelete: Restrict)
  estornadoPor          MovimentoEstoque?    @relation("EstornoDeMovimento")
  /// Saída maior que o saldo: confirmada de propósito, com justificativa.
  semSaldoConfirmado    Boolean              @default(false)
  justificativa         String?
  retalhosGerados       Retalho[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([produtoId, data])
  @@index([projetoId])
  @@index([itemRecebimentoId])
}

/// Sobra de perfil aproveitável (≥ retalhoMinimoMm de Configurações). Menor que isso vira sucata (MovimentoSucata).
model Retalho {
  id                 String            @id @default(cuid())
  produtoId          String
  produto            Produto           @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  comprimentoMm      Int
  local              String?
  status             StatusRetalho     @default(DISPONIVEL)
  origemProjetoId    String?
  origemProjeto      Projeto?          @relation("RetalhoOrigem", fields: [origemProjetoId], references: [id], onDelete: Restrict)
  origemMovimentoId  String?
  origemMovimento    MovimentoEstoque? @relation(fields: [origemMovimentoId], references: [id], onDelete: Restrict)
  consumidoProjetoId String?
  consumidoProjeto   Projeto?          @relation("RetalhoConsumo", fields: [consumidoProjetoId], references: [id], onDelete: Restrict)
  consumidoEm        DateTime?
  observacao         String?

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([produtoId, status])
  @@index([origemProjetoId])
}

/// Sucata acumulada para venda: saldo em kg. Sem peso por metro no perfil, guarda só o comprimento ("peso não informado").
model MovimentoSucata {
  id            String              @id @default(cuid())
  tipo          TipoMovimentoSucata
  data          DateTime            @db.Date
  pesoKg        Decimal?            @db.Decimal(10, 3)
  comprimentoMm Int?
  /// Venda de sucata: valor digitado (nunca inventado).
  valorCentavos Int?
  lancamentoId  String?
  lancamento    Lancamento?         @relation(fields: [lancamentoId], references: [id], onDelete: Restrict)
  projetoId     String?
  projeto       Projeto?            @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  produtoId     String?
  produto       Produto?            @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  observacao    String?

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([data])
  @@index([projetoId])
}

/// Pedido de compra (material ou vidro). O recebimento gera a entrada no estoque (destino ESTOQUE) ou o custo direto da obra
/// (destino OBRA) e, opcionalmente, a conta a pagar (`ContaPagar.compraId`).
model Compra {
  id                String              @id @default(cuid())
  /// Sequencial global (`C-0001`), pelo contador atômico "compra".
  numero            Int                 @unique
  fornecedorId      String
  fornecedor        Fornecedor          @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  tipo              TipoCompra          @default(MATERIAL)
  destino           DestinoCompra       @default(ESTOQUE)
  /// Obrigatório quando o destino é OBRA.
  projetoId         String?
  projeto           Projeto?            @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  status            StatusCompra        @default(RASCUNHO)
  dataPedido        DateTime?           @db.Date
  previsaoEntrega   DateTime?           @db.Date
  condicoes         String?
  observacao        String?
  itens             ItemCompra[]
  recebimentos      RecebimentoCompra[]
  contasPagar       ContaPagar[]
  historicoPrecos   HistoricoPreco[]
  historicoPrecosKg HistoricoPrecoKg[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([status, previsaoEntrega])
  @@index([fornecedorId])
  @@index([projetoId])
}

model ItemCompra {
  id                    String              @id @default(cuid())
  compraId              String
  compra                Compra              @relation(fields: [compraId], references: [id], onDelete: Restrict)
  ordem                 Int
  /// Produto do cadastro, ou só a descrição (vidro sob medida, item avulso).
  produtoId             String?
  produto               Produto?            @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  descricao             String?
  /// Unidade em que se compra e se paga (perfil: KG ou BARRA; os demais, a do produto).
  unidadeCompra         UnidadeProduto      @default(UN)
  quantidade            Decimal             @db.Decimal(12, 3)
  /// Cache da soma dos recebimentos, na unidade de compra.
  quantidadeRecebida    Decimal             @default(0) @db.Decimal(12, 3)
  /// Preço por unidade de compra; vazio = sem preço ("sem custo").
  precoUnitarioCentavos Int?
  // Vidro sob medida
  larguraMm             Int?
  alturaMm              Int?
  espessuraMm           Int?
  tipoVidroId           String?
  tipoVidro             TipoVidro?          @relation(fields: [tipoVidroId], references: [id], onDelete: Restrict)
  beneficiamentos       String?
  itemPropostaId        String?
  itemProposta          ItemProposta?       @relation(fields: [itemPropostaId], references: [id], onDelete: Restrict)
  itemPropostaMedidaId  String?
  itemPropostaMedida    ItemPropostaMedida? @relation(fields: [itemPropostaMedidaId], references: [id], onDelete: Restrict)
  recebimentos          ItemRecebimento[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@unique([compraId, ordem])
  @@index([produtoId])
  @@index([itemPropostaId])
}

model RecebimentoCompra {
  id         String            @id @default(cuid())
  compraId   String
  compra     Compra            @relation(fields: [compraId], references: [id], onDelete: Restrict)
  data       DateTime          @db.Date
  observacao String?
  itens      ItemRecebimento[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([compraId])
}

/// O que chegou de cada item, com o valor CONGELADO na hora: é daqui (e não da conta a pagar) que o custo real da obra lê.
model ItemRecebimento {
  id                    String             @id @default(cuid())
  recebimentoId         String
  recebimento           RecebimentoCompra  @relation(fields: [recebimentoId], references: [id], onDelete: Restrict)
  itemCompraId          String
  itemCompra            ItemCompra         @relation(fields: [itemCompraId], references: [id], onDelete: Restrict)
  /// Quantidade na unidade de compra (o que foi cobrado: kg ou barras).
  quantidadeCompra      Decimal            @db.Decimal(12, 3)
  /// Quantidade na unidade do produto (o que entra no estoque: ex. barras).
  quantidadeEstoque     Decimal            @db.Decimal(12, 3)
  /// Valor pago por esta entrega; vazio = sem preço ("sem custo").
  valorCentavos         Int?
  /// Custo por unidade do produto (valor ÷ quantidadeEstoque), arredondado; vazio quando não há preço.
  custoUnitarioCentavos Int?
  movimentos            MovimentoEstoque[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([recebimentoId])
  @@index([itemCompraId])
}
