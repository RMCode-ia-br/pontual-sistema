// Pontual Gestão — schema das Fases 0 (Fundação), 1 (Cadastros) e 2 (Comercial).
// Convenções (docs/ESPECIFICACAO.md, seção 4): nomes em português sem acento, dinheiro em
// centavos (Int), medidas em mm, exclusão lógica (deletadoEm) e colunas de auditoria.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================== Enums =====================

enum PapelUsuario {
  ADMIN
}

enum TipoDias {
  UTEIS
  CORRIDOS
}

enum TipoFeriado {
  FERIADO
  FERIAS_COLETIVA_FORNECEDORES
  OUTRO
}

enum TipoInteracao {
  LIGACAO
  WHATSAPP
  VISITA
  EMAIL
  NOTA
  SISTEMA
}

enum StatusTarefa {
  ABERTA
  CONCLUIDA
  CANCELADA
}

enum MomentoFoto {
  ANTES
  DURANTE
  DEPOIS
}

enum TipoCategoriaFinanceira {
  RECEITA
  DESPESA
}

enum CategoriaModeloTexto {
  PROPOSTA_NOTAS
  PROPOSTA_TERMOS
  WHATSAPP
  OUTRO
}

// ----- Fase 1 (Cadastros) -----

enum TipoPessoa {
  PF
  PJ
}

/// Origem do contato (R10). Também usada pelo Projeto na Fase 2.
enum OrigemContato {
  GOOGLE
  INDICACAO_CLIENTE
  ARQUITETO_PARCEIRO
  INSTAGRAM
  WHATSAPP
  SITE
  PLACA_NA_OBRA
  CLIENTE_ANTIGO
  OUTRO
}

enum TipoEndereco {
  COBRANCA
  OBRA
}

enum FuncaoFuncionario {
  VENDAS
  PROJETO
  FABRICA
  INSTALACAO
  ADMINISTRATIVO
  GESTAO
}

enum UnidadeProduto {
  UN
  M
  M2
  KG
  BARRA
  L
  PAR
  CJ
}

/// De onde veio a mudança de custo (R13).
enum OrigemPreco {
  MANUAL
  REAJUSTE_LOTE
  IMPORTACAO
}

enum TipoImportacao {
  CLIENTES
  FORNECEDORES
  PRODUTOS
}

enum StatusLoteImportacao {
  APLICADO
  REVERTIDO
}

enum AcaoLoteItem {
  CRIADO
  ATUALIZADO
}

// ===================== Sistema =====================

model Usuario {
  id                 String         @id @default(cuid())
  nome               String
  /// Sempre gravado em minúsculas (login não diferencia maiúsculas).
  login              String         @unique
  /// Opcional; único quando preenchido. Sempre em minúsculas.
  email              String?        @unique
  senhaHash          String
  ativo              Boolean        @default(true)
  papel              PapelUsuario   @default(ADMIN)
  precisaTrocarSenha Boolean        @default(true)
  /// Incrementada ao trocar/redefinir senha ou desativar: invalida sessões antigas.
  versaoSessao       Int            @default(1)
  ultimoLoginEm      DateTime?
  funcionario        Funcionario?
  projetos           Projeto[]
  eventosAgenda      EventoAgenda[]
  feedsAgenda        FeedAgenda[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([ativo])
}

model TentativaLogin {
  id            String   @id @default(cuid())
  /// Login ou e-mail digitado, em minúsculas.
  identificador String
  ip            String
  sucesso       Boolean
  criadoEm      DateTime @default(now())

  @@index([identificador, criadoEm])
  @@index([ip, criadoEm])
}

model ConfiguracaoEmpresa {
  /// Singleton: sempre "singleton".
  id                  String  @id @default("singleton")
  razaoSocial         String?
  nomeFantasia        String?
  cnpj                String?
  endereco            String?
  cidade              String?
  uf                  String?
  cep                 String?
  telefone            String?
  whatsapp            String?
  emailContato        String?
  emailPropostas      String?
  siteUrl             String?
  instagramUrl        String?
  googlePerfilUrl     String?
  /// Link direto para escrever avaliação (diferente do link de compartilhamento do perfil).
  linkAvaliacaoGoogle String?
  logoCaminho         String?
  corPrimaria         String?

  // Horário comercial (HH:mm); vazio = sem expediente naquele dia.
  horarioSemanaInicio String? @default("08:00")
  horarioSemanaFim    String? @default("18:00")
  horarioSabadoInicio String? @default("08:00")
  horarioSabadoFim    String? @default("12:00")
  visitaDuracaoMin    Int     @default(60)

  // Parâmetros de negócio. Alíquota e margens ficam VAZIAS até o gestor definir.
  aliquotaImpostoPercentual     Decimal? @db.Decimal(5, 2)
  margemPadraoPercentual        Decimal? @db.Decimal(5, 2)
  margemMinimaAlertaPercentual  Decimal? @db.Decimal(5, 2)
  metaFaturamentoMensalCentavos Int      @default(30000000)
  capacidadeProducaoM2Mes       Int      @default(300)
  garantiaRegulagemDias         Int      @default(90)
  retalhoMinimoMm               Int?
  custoMaoDeObraPorM2Centavos   Int?
  tipoDias                      TipoDias @default(UTEIS)
  diasFollowUpProposta          Int      @default(3)
  /// R11: dias sem resposta para a proposta entrar na lista "Sem retorno" (padrão de configuração, editável).
  diasSemRetornoProposta        Int      @default(7)
  /// R11: dias após a conclusão da obra para a tarefa "Pedir avaliação no Google".
  diasPedidoAvaliacao           Int      @default(2)
  /// R10: faixas OPCIONAIS para sugerir o porte. Vazias até o gestor definir (nunca inventadas).
  porteMedioMinimoCentavos      Int?
  porteGrandeMinimoCentavos     Int?
  diasAlertaPrazoAmarelo        Int      @default(3)
  limiteSimplesCentavos         Int      @default(480000000)

  // Propostas
  proximoNumeroProposta   Int?
  reiniciaNumeracaoPorAno Boolean @default(false)
  consultorNome           String?
  consultorCargo          String?
  dadosPagamento          String?
  pdfExibirValorPorItem   Boolean @default(true)
  pdfDescricoesMaiusculas Boolean @default(true)

  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
}

model Feriado {
  id      String      @id @default(cuid())
  data    DateTime    @db.Date
  nome    String
  tipo    TipoFeriado @default(FERIADO)
  /// Fim do período, para férias coletivas (vazio = só um dia).
  dataFim DateTime?   @db.Date
  ativo   Boolean     @default(true)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@unique([data, nome])
  @@index([data])
}

model LogAuditoria {
  id          String   @id @default(cuid())
  criadoEm    DateTime @default(now())
  usuarioId   String?
  /// Nome do usuário no momento da ação (preserva o histórico se o usuário for removido).
  usuarioNome String?
  entidade    String
  entidadeId  String
  /// CRIAR, ATUALIZAR, EXCLUIR, RESTAURAR, LOGIN, etc.
  acao        String
  antes       Json?
  depois      Json?
  ip          String?

  @@index([entidade, entidadeId])
  @@index([usuarioId, criadoEm])
  @@index([criadoEm])
}

model Anexo {
  id              String       @id @default(cuid())
  entidadeTipo    String
  entidadeId      String
  categoria       String?
  nome            String
  /// Caminho do objeto no bucket privado do Storage.
  caminho         String       @unique
  mime            String
  tamanhoBytes    Int
  descricao       String?
  momento         MomentoFoto?
  usarNoPortfolio Boolean      @default(true)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([entidadeTipo, entidadeId])
}

model Interacao {
  id        String        @id @default(cuid())
  tipo      TipoInteracao
  texto     String
  clienteId String?
  cliente   Cliente?      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  projetoId String?
  projeto   Projeto?      @relation(fields: [projetoId], references: [id], onDelete: Restrict)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([clienteId, criadoEm])
  @@index([projetoId, criadoEm])
}

model Tarefa {
  id            String       @id @default(cuid())
  titulo        String
  descricao     String?
  tipo          String?
  responsavelId String?
  vencimento    DateTime?    @db.Date
  status        StatusTarefa @default(ABERTA)
  concluidaEm   DateTime?
  clienteId     String?
  cliente       Cliente?     @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  projetoId     String?
  projeto       Projeto?     @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  /// Evita duplicar tarefas automáticas (ex.: "follow-up:proposta:123").
  chaveUnica    String?      @unique

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([responsavelId, status, vencimento])
  @@index([status, vencimento])
  @@index([projetoId, status])
}

model Notificacao {
  id         String   @id @default(cuid())
  /// Vazio = para todos os usuários.
  usuarioId  String?
  tipo       String
  titulo     String
  texto      String?
  link       String?
  lida       Boolean  @default(false)
  /// Idempotência das notificações geradas pelo cron.
  chaveUnica String?  @unique
  criadoEm   DateTime @default(now())

  @@index([usuarioId, lida, criadoEm])
}

model ModeloTexto {
  id        String               @id @default(cuid())
  chave     String               @unique
  titulo    String
  categoria CategoriaModeloTexto @default(OUTRO)
  conteudo  String
  ativo     Boolean              @default(true)
  ordem     Int                  @default(0)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

// ===================== Catálogos editáveis =====================

model LinhaAluminio {
  id              String    @id @default(cuid())
  nome            String    @unique
  ativo           Boolean   @default(true)
  ordem           Int       @default(0)
  produtos        Produto[]
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model AcabamentoAluminio {
  id              String    @id @default(cuid())
  nome            String    @unique
  ativo           Boolean   @default(true)
  ordem           Int       @default(0)
  produtos        Produto[]
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model TipoVidro {
  id              String    @id @default(cuid())
  nome            String    @unique
  ativo           Boolean   @default(true)
  ordem           Int       @default(0)
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model EspessuraVidro {
  id              String    @id @default(cuid())
  /// Espessura em milímetros (ex.: 6, 8, 10).
  mm              Int       @unique
  ativo           Boolean   @default(true)
  ordem           Int       @default(0)
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model CategoriaProduto {
  id              String       @id @default(cuid())
  nome            String       @unique
  ativo           Boolean      @default(true)
  ordem           Int          @default(0)
  produtos        Produto[]
  fornecedores    Fornecedor[]
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model MotivoPerda {
  id              String    @id @default(cuid())
  nome            String    @unique
  ativo           Boolean   @default(true)
  ordem           Int       @default(0)
  projetos        Projeto[]
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model MotivoBloqueio {
  id              String    @id @default(cuid())
  nome            String    @unique
  /// Pausa justificada (não imputável à Pontual) estende o prazo prometido (R8).
  justificado     Boolean   @default(true)
  ativo           Boolean   @default(true)
  ordem           Int       @default(0)
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?
}

model CategoriaFinanceira {
  id              String                  @id @default(cuid())
  nome            String
  tipo            TipoCategoriaFinanceira
  /// Grupo usado no DRE gerencial.
  grupoDre        String?
  ativo           Boolean                 @default(true)
  ordem           Int                     @default(0)
  criadoEm        DateTime                @default(now())
  atualizadoEm    DateTime                @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@unique([tipo, nome])
}

// ===================== Cadastros (Fase 1) =====================

model Cliente {
  id               String          @id @default(cuid())
  tipoPessoa       TipoPessoa      @default(PF)
  /// Nome (PF) ou razão social (PJ).
  nome             String
  nomeFantasia     String?
  /// Só dígitos (CPF com 11 ou CNPJ com 14). Duplicidade é avisada na tela, não imposta no banco.
  cpfCnpj          String?
  /// E.164 ("+5522999583288").
  telefone         String?
  whatsapp         String?
  email            String?
  // Marcações combináveis (R18).
  clienteFinal     Boolean         @default(true)
  arquiteto        Boolean         @default(false)
  construtora      Boolean         @default(false)
  empresa          Boolean         @default(false)
  origem           OrigemContato?
  origemDetalhe    String?
  indicadoPorId    String?
  indicadoPor      Cliente?        @relation("Indicacao", fields: [indicadoPorId], references: [id], onDelete: Restrict)
  indicados        Cliente[]       @relation("Indicacao")
  observacoes      String?
  ativo            Boolean         @default(true)
  loteImportacaoId String?
  loteImportacao   LoteImportacao? @relation(fields: [loteImportacaoId], references: [id], onDelete: Restrict)

  enderecos               EnderecoCliente[]
  contatos                ContatoCliente[]
  interacoes              Interacao[]
  tarefas                 Tarefa[]
  projetos                Projeto[]         @relation("ProjetoCliente")
  projetosComoArquiteto   Projeto[]         @relation("ProjetoArquiteto")
  projetosComoConstrutora Projeto[]         @relation("ProjetoConstrutora")
  eventosAgenda           EventoAgenda[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, ativo, nome])
  @@index([cpfCnpj])
  @@index([telefone])
  @@index([whatsapp])
  @@index([arquiteto])
  @@index([construtora])
  @@index([indicadoPorId])
  @@index([loteImportacaoId])
}

model EnderecoCliente {
  id                    String         @id @default(cuid())
  clienteId             String
  cliente               Cliente        @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  tipo                  TipoEndereco   @default(OBRA)
  apelido               String?
  logradouro            String?
  numero                String?
  complemento           String?
  bairro                String?
  cidade                String?
  uf                    String?
  cep                   String?
  // Condomínio (R9): exige aprovação da fachada, horários permitidos, contato do síndico.
  condominio            Boolean        @default(false)
  condominioNome        String?
  exigeAprovacaoFachada Boolean        @default(false)
  fachadaAprovada       Boolean        @default(false)
  horariosPermitidos    String?
  sindicoNome           String?
  sindicoTelefone       String?
  projetos              Projeto[]
  eventosAgenda         EventoAgenda[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([clienteId, deletadoEm])
}

model ContatoCliente {
  id          String  @id @default(cuid())
  clienteId   String
  cliente     Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  nome        String
  cargo       String?
  telefone    String?
  whatsapp    String?
  email       String?
  observacoes String?

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([clienteId, deletadoEm])
}

model Fornecedor {
  id                 String             @id @default(cuid())
  razaoSocial        String
  nomeFantasia       String?
  cnpj               String?
  categorias         CategoriaProduto[]
  vendedorNome       String?
  telefone           String?
  email              String?
  condicoesPagamento String?
  prazoEntregaDias   Int?
  observacoes        String?
  ativo              Boolean            @default(true)
  loteImportacaoId   String?
  loteImportacao     LoteImportacao?    @relation(fields: [loteImportacaoId], references: [id], onDelete: Restrict)
  produtos           Produto[]
  historicoPrecos    HistoricoPreco[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, ativo, razaoSocial])
  @@index([cnpj])
  @@index([loteImportacaoId])
}

model Funcionario {
  id                  String            @id @default(cuid())
  nome                String
  cpf                 String?
  telefone            String?
  email               String?
  cargo               String?
  funcao              FuncaoFuncionario
  admissaoEm          DateTime?         @db.Date
  demissaoEm          DateTime?         @db.Date
  salarioBaseCentavos Int?
  custoHoraCentavos   Int?
  observacoes         String?
  ativo               Boolean           @default(true)
  usuarioId           String?           @unique
  usuario             Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  equipes             EquipeMembro[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, ativo, nome])
  @@index([cpf])
}

model Equipe {
  id            String         @id @default(cuid())
  nome          String
  descricao     String?
  ativo         Boolean        @default(true)
  membros       EquipeMembro[]
  eventosAgenda EventoAgenda[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, ativo, nome])
}

/// Ao tirar alguém da equipe, `deletadoEm` é preenchido; ao recolocar, é limpo (a unicidade vale sempre).
model EquipeMembro {
  id            String      @id @default(cuid())
  equipeId      String
  equipe        Equipe      @relation(fields: [equipeId], references: [id], onDelete: Restrict)
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)
  lider         Boolean     @default(false)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@unique([equipeId, funcionarioId])
  @@index([funcionarioId])
}

model Produto {
  id                    String              @id @default(cuid())
  /// Único entre os não excluídos (índice parcial criado na migração).
  codigo                String
  descricao             String
  categoriaId           String?
  categoria             CategoriaProduto?   @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  unidade               UnidadeProduto      @default(UN)
  linhaId               String?
  linha                 LinhaAluminio?      @relation(fields: [linhaId], references: [id], onDelete: Restrict)
  acabamentoId          String?
  acabamento            AcabamentoAluminio? @relation(fields: [acabamentoId], references: [id], onDelete: Restrict)
  fornecedorPrincipalId String?
  fornecedorPrincipal   Fornecedor?         @relation(fields: [fornecedorPrincipalId], references: [id], onDelete: Restrict)
  /// Vazio = custo ainda não informado (nunca inventamos preço).
  custoUnitarioCentavos Int?
  custoAtualizadoEm     DateTime?
  comprimentoBarraMm    Int?
  pesoKgPorMetro        Decimal?            @db.Decimal(8, 3)
  /// Só para produto acabado de pronta entrega.
  larguraMm             Int?
  alturaMm              Int?
  /// Vazio = sem alerta de estoque mínimo (R14).
  estoqueMinimo         Decimal?            @db.Decimal(12, 3)
  localizacao           String?
  observacoes           String?
  ativo                 Boolean             @default(true)
  loteImportacaoId      String?
  loteImportacao        LoteImportacao?     @relation(fields: [loteImportacaoId], references: [id], onDelete: Restrict)
  historicoPrecos       HistoricoPreco[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, ativo, descricao])
  @@index([categoriaId])
  @@index([linhaId])
  @@index([fornecedorPrincipalId])
  @@index([loteImportacaoId])
}

/// Toda mudança de custo de um produto (R13). Só se acrescenta; nunca se edita.
model HistoricoPreco {
  id                    String          @id @default(cuid())
  produtoId             String
  produto               Produto         @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  custoAnteriorCentavos Int?
  custoNovoCentavos     Int
  origem                OrigemPreco
  fornecedorId          String?
  fornecedor            Fornecedor?     @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  usuarioId             String?
  loteImportacaoId      String?
  loteImportacao        LoteImportacao? @relation(fields: [loteImportacaoId], references: [id], onDelete: Restrict)
  /// Descrição curta do reajuste em lote ("+5% — Fornecedor X").
  observacao            String?

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([produtoId, criadoEm])
  @@index([loteImportacaoId])
}

model LoteImportacao {
  id              String               @id @default(cuid())
  tipo            TipoImportacao
  nomeArquivo     String
  totalLinhas     Int
  criados         Int                  @default(0)
  atualizados     Int                  @default(0)
  ignorados       Int                  @default(0)
  status          StatusLoteImportacao @default(APLICADO)
  revertidoEm     DateTime?
  revertidoPorId  String?
  itens           LoteImportacaoItem[]
  clientes        Cliente[]
  fornecedores    Fornecedor[]
  produtos        Produto[]
  historicoPrecos HistoricoPreco[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([tipo, criadoEm])
}

/// O que cada lote fez, para poder reverter: criados vão para a lixeira; atualizados voltam ao `antes`.
model LoteImportacaoItem {
  id         String         @id @default(cuid())
  loteId     String
  lote       LoteImportacao @relation(fields: [loteId], references: [id], onDelete: Restrict)
  entidadeId String
  acao       AcaoLoteItem
  /// Valores anteriores (só quando ATUALIZADO).
  antes      Json?

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([loteId])
}

/// Filtros salvos por usuário e tela (spec 7: "todas as listas ... com filtros salvos").
model FiltroSalvo {
  id        String @id @default(cuid())
  usuarioId String
  /// Identificador da lista ("clientes", "produtos"...).
  tela      String
  nome      String
  /// Query string da lista, sem o "?" e sem a página.
  consulta  String

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@unique([usuarioId, tela, nome])
}

// ===================== Fase 2 (Comercial: funil e agenda) =====================

/// Fases do projeto (spec seção 6). APROVADO só é alcançado pela aprovação de proposta (Fase 3).
enum StatusProjeto {
  NOVO_LEAD
  VISITA_AGENDADA
  ELABORANDO_PROPOSTA
  PROPOSTA_ENVIADA
  NEGOCIACAO
  APROVADO
  EM_EXECUCAO
  CONCLUIDO
  PERDIDO
  CANCELADO
}

enum PorteProjeto {
  PEQUENO
  MEDIO
  GRANDE
}

enum InteresseProjeto {
  COMPRA_REAL
  SO_ORCAMENTO_ESPECULACAO
  INDEFINIDO
}

enum TemperaturaProjeto {
  FRIA
  MORNA
  QUENTE
}

/// Fase da obra do cliente (R9).
enum FaseObraCliente {
  PLANTA
  EM_CONSTRUCAO
  PRONTA
}

enum TipoServico {
  JANELA
  PORTA
  BOX
  GUARDA_CORPO
  FECHAMENTO_SACADA
  PORTAO
  PERGOLADO
  ESPELHO
  OUTRO
}

enum TipoEventoAgenda {
  VISITA_TECNICA
  MEDICAO_EXATA
  MEDICAO_VIDROS
  INSTALACAO
  ENTREGA
  ASSISTENCIA
  REUNIAO
}

enum StatusEventoAgenda {
  AGENDADO
  CONFIRMADO
  REALIZADO
  REMARCADO
  CANCELADO
  NAO_COMPARECEU
}

/// `Projeto` é a entidade única do ciclo inteiro (comercial → obra). Dinheiro em centavos.
/// `valorFechado`, prazos e pausas entram nas Fases 3 e 4 (não adiantar tabelas/campos de fases futuras).
model Projeto {
  id                           String              @id @default(cuid())
  /// P-AAAA-NNNN (contador anual em ContadorSequencia).
  codigo                       String              @unique
  titulo                       String
  clienteId                    String
  cliente                      Cliente             @relation("ProjetoCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  enderecoObraId               String?
  enderecoObra                 EnderecoCliente?    @relation(fields: [enderecoObraId], references: [id], onDelete: Restrict)
  arquitetoId                  String?
  arquiteto                    Cliente?            @relation("ProjetoArquiteto", fields: [arquitetoId], references: [id], onDelete: Restrict)
  construtoraId                String?
  construtora                  Cliente?            @relation("ProjetoConstrutora", fields: [construtoraId], references: [id], onDelete: Restrict)
  responsavelId                String?
  responsavel                  Usuario?            @relation(fields: [responsavelId], references: [id], onDelete: Restrict)
  status                       StatusProjeto       @default(NOVO_LEAD)
  tiposServico                 TipoServico[]
  origem                       OrigemContato?
  origemDetalhe                String?
  canal                        String?
  porte                        PorteProjeto?
  interesse                    InteresseProjeto    @default(INDEFINIDO)
  temperatura                  TemperaturaProjeto?
  faseDaObra                   FaseObraCliente?
  investimentoPrevistoCentavos Int?
  valorEstimadoCentavos        Int?
  /// Texto livre ("até março", "antes do Natal").
  prazoDesejado                String?
  motivoPerdaId                String?
  motivoPerda                  MotivoPerda?        @relation(fields: [motivoPerdaId], references: [id], onDelete: Restrict)
  motivoPerdaDetalhe           String?
  /// Quando o motivo é "escolheu concorrente": qual (opcional).
  concorrente                  String?
  /// Preenchido pela IA de atendimento no futuro (spec seção 6).
  resumoAtendimento            String?
  observacoes                  String?
  perdidoEm                    DateTime?
  /// Última mudança de fase: base de "dias parado" e da lista "Sem retorno".
  ultimaMovimentacaoEm         DateTime            @default(now())

  tarefas        Tarefa[]
  interacoes     Interacao[]
  eventos        EventoAgenda[]
  medidas        MedidaRascunho[]
  historicoFases HistoricoFaseProjeto[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, status, ultimaMovimentacaoEm])
  @@index([clienteId])
  @@index([responsavelId, status])
  @@index([origem])
  @@index([arquitetoId])
  @@index([construtoraId])
  @@index([criadoEm])
}

/// Cada mudança de fase (alimenta conversão por fase e "tempo visita → proposta enviada").
model HistoricoFaseProjeto {
  id          String         @id @default(cuid())
  projetoId   String
  projeto     Projeto        @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  /// Vazio na criação do projeto.
  de          StatusProjeto?
  para        StatusProjeto
  criadoEm    DateTime       @default(now())
  criadoPorId String?

  @@index([projetoId, criadoEm])
  @@index([para, criadoEm])
}

/// Visitas, medições, instalações, entregas e assistências. Instantes em UTC; exibição em America/Sao_Paulo.
model EventoAgenda {
  id            String             @id @default(cuid())
  tipo          TipoEventoAgenda
  titulo        String?
  inicio        DateTime
  fim           DateTime
  responsavelId String?
  responsavel   Usuario?           @relation(fields: [responsavelId], references: [id], onDelete: Restrict)
  equipeId      String?
  equipe        Equipe?            @relation(fields: [equipeId], references: [id], onDelete: Restrict)
  clienteId     String?
  cliente       Cliente?           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  projetoId     String?
  projeto       Projeto?           @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  enderecoId    String?
  endereco      EnderecoCliente?   @relation(fields: [enderecoId], references: [id], onDelete: Restrict)
  /// Local em texto (cópia do endereço da obra no momento do agendamento ou digitado).
  local         String?
  status        StatusEventoAgenda @default(AGENDADO)
  /// Minutos de antecedência do lembrete (ex.: 1440 = 24 h). Vazio = sem lembrete.
  lembreteMin   Int?
  observacoes   String?
  realizadoEm   DateTime?
  medidas       MedidaRascunho[]

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([deletadoEm, inicio])
  @@index([responsavelId, inicio])
  @@index([equipeId, inicio])
  @@index([projetoId])
  @@index([clienteId])
  @@index([status, inicio])
}

/// Medidas anotadas na visita (R9). Fotos ficam em `Anexo` (entidadeTipo = "MedidaRascunho").
model MedidaRascunho {
  id         String        @id @default(cuid())
  projetoId  String
  projeto    Projeto       @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  eventoId   String?
  evento     EventoAgenda? @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  ambiente   String?
  /// Texto livre por ora; vira vínculo com Tipologia na Fase 3.
  tipologia  String?
  larguraMm  Int?
  alturaMm   Int?
  quantidade Int           @default(1)
  observacao String?
  ordem      Int           @default(0)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([projetoId, deletadoEm, ordem])
  @@index([eventoId])
}

/// Feed .ics assinável por token secreto (só o hash é guardado) e revogável.
model FeedAgenda {
  id             String    @id @default(cuid())
  usuarioId      String
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  nome           String?
  /// SHA-256 (hex) do token. O token em claro é mostrado uma única vez.
  tokenHash      String    @unique
  ultimoAcessoEm DateTime?
  revogadoEm     DateTime?

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  criadoPorId     String?
  atualizadoPorId String?
  deletadoEm      DateTime?

  @@index([usuarioId, revogadoEm])
}

/// Contadores sequenciais transacionais (ex.: "projeto:2026"). Reaproveitável pelas propostas (Fase 3).
model ContadorSequencia {
  chave        String   @id
  valor        Int      @default(0)
  atualizadoEm DateTime @updatedAt
}
