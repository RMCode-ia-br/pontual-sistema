# Copie para .env.local e preencha. NUNCA commite valores reais.
# Dica: se a senha do banco tiver caracteres especiais (@ # : / ? %), codifique-a na URL
# (encodeURIComponent), senão a URL fica inválida.

# Projeto Supabase em São Paulo (sa-east-1); funções da Vercel em gru1 (vercel.json).
# Supabase, Transaction pooler (porta 6543, ?pgbouncer=true). Usada pelo app (ideal em serverless).
DATABASE_URL=
# Supabase, SESSION POOLER (porta 5432, usuário postgres.<ref>). Usada em migrações, seed e backup.
# NÃO use a conexão direta db.<ref>.supabase.co: ela só resolve em IPv6 e não conecta de redes IPv4.
DIRECT_URL=
# URL do projeto Supabase
SUPABASE_URL=
# Chave secreta (service role). Só no servidor, nunca no navegador.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=anexos
# Gere com: npx auth secret
AUTH_SECRET=
# URL pública do app (local: http://localhost:3000)
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protege /api/cron/diario. Gere um valor aleatório longo.
CRON_SECRET=
# Origens do site com CORS em /api/public (separadas por vírgula)
SITE_ALLOWED_ORIGINS=https://pontualmacae.com.br

# Apenas desenvolvimento: libera "npm run seed:demo" (dados fictícios).
# ALLOW_DEMO_SEED=true

# Seed: senha inicial do usuário "admin" (obrigatória com NODE_ENV=production; mínimo 8 caracteres).
# Sem ela, em desenvolvimento o seed usa a senha padrão pública "admin". Troca obrigatória no 1º acesso.
# ADMIN_SENHA_INICIAL=
