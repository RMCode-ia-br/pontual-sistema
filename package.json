{
  "name": "pontual-sistema",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "postinstall": "prisma generate",
    "storage:setup": "tsx scripts/storage-setup.ts",
    "test:integracao": "vitest run --config vitest.integracao.config.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.14",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "prisma@7.10.1": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22"
  }
}
